# ==============================================================================
# LightHouse Reading Stack — Portable Environment Template
# ==============================================================================
# Quick Start:
#   cp .env.example .env
#   bin/lighthouse status
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Stack & Path Resolution
# ------------------------------------------------------------------------------
# Root directory of the repository (defaults to auto-detected repository root)
# LIGHTHOUSE_ROOT=.

# System & Locales
PUID=1000
PGID=1000
TZ=Asia/Yangon

# ------------------------------------------------------------------------------
# 2. Network Ports & Local Listeners
# ------------------------------------------------------------------------------
# Reading HQ Dashboard & API
UPLOADER_PORT=8086
# KOReader Progress Sync Server
KOSYNC_PORT=7200
# Calibre Content Server / OPDS Feed
CALIBRE_PORT=8088
# Local Sing-box / SOCKS5 Proxy Port
PROXY_PORT=7890

# Local service URLs
CALIBRE_SERVER_URL=http://127.0.0.1:8088

# ------------------------------------------------------------------------------
# 3. Storage Paths & Database Locations
# ------------------------------------------------------------------------------
# Path to the primary Calibre library directory (containing metadata.db)
CALIBRE_LIBRARY_DIR="${HOME}/Calibre Libraries/Agent Library"

# Optional explicit path to Calibre metadata.db (defaults to ${CALIBRE_LIBRARY_DIR}/metadata.db)
# CALIBRE_DB_PATH="${CALIBRE_LIBRARY_DIR}/metadata.db"

# Deadline in ms for each out-of-process library probe run before the port is bound.
# The server refuses to start unless the library root and metadata.db are readable;
# see "Startup Library Preflight" in README.md for the verdicts and remedies.
# LIGHTHOUSE_LIBRARY_PROBE_TIMEOUT_MS=5000

# KOReader Sync SQLite database
KOSYNC_DB_PATH="${HOME}/kosync-server/data/koreader-sync.db"

# Reading HQ cache and durable jobs SQLite database
CACHE_DB_PATH="./uploader/cache.db"
JOBS_DB_PATH="./uploader/cache.db"

# Manga processor database (optional)
MANGA_DB_PATH="${HOME}/manga-processor/manga.db"
MANGA_DIR="${HOME}/Manga"

# Monitored incoming books drop directory
BOOKS_DROP_DIR="${HOME}/Books_Drop"

# Safe local backup archive storage directory
BACKUP_DIR="${HOME}/.backups/reading-stack"

# Optional secondary external backup mirror (e.g. external SSD)
# SSD_BACKUP_DIR="/Volumes/External_SSD/backups/reading-stack"

# Log files directory (macOS default: ${HOME}/Library/Logs)
LOG_DIR="${HOME}/Library/Logs"

# ------------------------------------------------------------------------------
# 4. Outbound Proxy & External Scrapers
# ------------------------------------------------------------------------------
# Local proxy gateway for Telegram bot and external scrapers
PROXY_URL=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890

# Jina / Jev Reader API Key (for paywalled/Cloudflare-protected web articles)
JINA_API_KEY=
JEV_API_KEY=

# Firecrawl on-demand web article scraper cluster
# FIRECRAWL_ENABLED=true
# FIRECRAWL_PORT=3002
# FIRECRAWL_URL=http://127.0.0.1:3002
# FIRECRAWL_COMPOSE_DIR="${HOME}/Documents/Firecrawl/firecrawl"
# FIRECRAWL_IDLE_TIMEOUT_MS=900000
# FIRECRAWL_ACTIVITY_DIR="${TMPDIR:-/tmp}/lighthouse-firecrawl-activity" # defaults to os.tmpdir()/lighthouse-firecrawl-activity
# FIRECRAWL_API_KEY=
# DOCKER_PATH=docker

# ------------------------------------------------------------------------------
# 5. Telegram Ingestion Bot & Notifications
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Chat ID for backup delivery and alert notifications (auto-populated by /backup)
TELEGRAM_BACKUP_CHAT_ID=

# ------------------------------------------------------------------------------
# 6. Security, Authentication & CORS
# ------------------------------------------------------------------------------
# KOSync Authentication Salt - REQUIRED. There is no default anywhere in this repository.
# Deliberately empty: docker compose refuses to start until you put a real value here.
# Generate your own, e.g. openssl rand -hex 24
# WARNING: changing the salt invalidates every existing password hash in koreader-sync.db.
KOSYNC_PASSWORD_SALT=

# Reading HQ API Key (required for mutating WAN requests: upload, ingest, delete)
# This key always grants full access ('*'); existing clients keep working.
READING_API_KEY=

# Optional additional API keys with limited scopes (least privilege).
# Compact form: name=secret:scopes entries separated by ';' or newlines.
# JSON also accepted: {"ci":{"key":"secret","scopes":["read"]}}
# Scopes: read < write < admin (write implies read; admin covers /api/backup,
# /api/ssd, /api/system). Read-only keys get HTTP 403 on mutations; unknown or
# revoked keys get HTTP 401. Never reuse READING_API_KEY here.
# Example: koreader-sync=ro-secret:read;ci-writer=rw-secret:write
READING_SCOPED_KEYS=

# Comma-separated list of additional permitted CORS origins
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 7. Telegram Mini App / Web URL (LAN-first)
# ------------------------------------------------------------------------------
READING_WEBAPP_URL=http://192.168.31.15:8086

# ------------------------------------------------------------------------------
# 8. Pluggable Metadata Providers (sidecars)
# ------------------------------------------------------------------------------
# Enrichment sources beyond the built-in scrapers run as HTTP sidecars beside the
# server. See docs/metadata-providers.md for the interface and protocol.
#
# Inline JSON array (or {"providers":[...]}) describing sidecar providers:
# LIGHTHOUSE_METADATA_PROVIDERS=[{"id":"douban","label":"Douban","endpoint":"http://127.0.0.1:8099","priority":60,"categories":["general_book","other"]}]
#
# Path to a JSON manifest instead of inline JSON (default: data/metadata-providers.json)
# LIGHTHOUSE_METADATA_PROVIDERS_FILE=
#
# Disable every sidecar provider without deleting the config (built-ins still run)
# LIGHTHOUSE_METADATA_PROVIDERS_OFF=0
