# Home Reading Stack — Standby Environment Variables
# Copy to .env and adjust paths as needed:
#   cp .env.example .env

# Network Ports
KOSYNC_PORT=7200
CALIBRE_PORT=8088
UPLOADER_PORT=8086

# System & Locales
PUID=1000
PGID=1000
TZ=Asia/Yangon

# KOSync Authentication Salt
KOSYNC_PASSWORD_SALT=your_kosync_password_salt_here

# Telegram Ingestion Bot Token & Backup Delivery
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Auto-populated when you send /backup to the Telegram bot, or set manually:
TELEGRAM_BACKUP_CHAT_ID=

# Storage Mounts on Mac Mini Host
CALIBRE_LIBRARY_DIR="/Volumes/Ospeto_SSD/Calibre Library"
MANGA_DIR="/Volumes/Ospeto_SSD/Manga"
BOOKS_DROP_DIR="${HOME}/Books_Drop"
BACKUP_DIR="/Volumes/Ospeto_SSD/backups/reading-stack"

# Local VLESS Proxy Gateway (for Telegram Bot & External Scrapers)
HTTP_PROXY=http://host.docker.internal:7890
HTTPS_PROXY=http://host.docker.internal:7890

# Public WAN Surface Security & Authentication
# Required for mutating API requests (upload, ingest, delete) originating from WAN reverse-tunnel:
READING_API_KEY=
# Comma-separated list of additional permitted CORS origins (defaults to https://reading.wavypremium.xyz and local LAN):
ALLOWED_ORIGINS=
# Path to SQLite database holding durable jobs (defaults to cache.db):
JOBS_DB_PATH=./cache.db
