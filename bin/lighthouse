    <key>ProgramArguments</key>
    <array>
        <string>${P_SSH}</string>
        <string>-N</string>
        <string>-R</string>
        <string>127.0.0.1:${P_UPLOADER_PORT}:127.0.0.1:${P_UPLOADER_PORT}</string>
        <string>-R</string>
        <string>127.0.0.1:${P_KOSYNC_PORT}:127.0.0.1:${P_KOSYNC_PORT}</string>
        <string>-o</string>
        <string>ServerAliveInterval=15</string>
        <string>-o</string>
        <string>ServerAliveCountMax=3</string>
        <string>-o</string>
        <string>ExitOnForwardFailure=yes</string>
        <string>-o</string>
        <string>BatchMode=yes</string>
        <string>-o</string>
        <string>ConnectTimeout=8</string>
        <string>${P_SG_REMOTE}</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${P_LOG_DIR}/reading-sg-tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>${P_LOG_DIR}/reading-sg-tunnel.log</string>
</dict>
</plist>
EOF

  # 6. Daily Backup Plist
  local backup_plist="${target_dir}/${DAEMON_PREFIX}.reading-stack-backup.plist"
  cat << EOF > "$backup_plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${P_PREFIX}.reading-stack-backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>${P_BASH}</string>
        <string>${P_ROOT}/scripts/backup-daily.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LIGHTHOUSE_ROOT</key>
        <string>${P_ROOT}</string>
        <key>HOME</key>
        <string>${P_HOME}</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>${P_LOG_DIR}/reading-stack-backup.log</string>
    <key>StandardErrorPath</key>
    <string>${P_LOG_DIR}/reading-stack-backup.log</string>
</dict>
</plist>
EOF

  # 7. External SSD Backup Plist (configured time & enabled state)
  local ssd_hour=3
  local ssd_minute=0
  local ssd_enabled=0
  local ssd_cfg_file="${LIGHTHOUSE_ROOT}/data/ssd-backup-config.json"
  if [ -f "$ssd_cfg_file" ]; then
    local parsed_time
    parsed_time=$(grep -o '"scheduleTime"[[:space:]]*:[[:space:]]*"[^"]*"' "$ssd_cfg_file" | sed -e 's/.*"scheduleTime"[[:space:]]*:[[:space:]]*"//' -e 's/"//' 2>/dev/null || echo "03:00")
    if [[ "$parsed_time" =~ ^([0-9]{1,2}):([0-9]{2})$ ]]; then
      local candidate_h=$(( 10#${BASH_REMATCH[1]} ))
      local candidate_m=$(( 10#${BASH_REMATCH[2]} ))
      if [ "$candidate_h" -ge 0 ] && [ "$candidate_h" -le 23 ] && [ "$candidate_m" -ge 0 ] && [ "$candidate_m" -le 59 ]; then
        ssd_hour="$candidate_h"
        ssd_minute="$candidate_m"
      fi
    fi
    if grep -q '"enabled"[[:space:]]*:[[:space:]]*true' "$ssd_cfg_file" 2>/dev/null; then
      ssd_enabled=1
    fi
  fi

  local ssd_backup_plist="${target_dir}/${DAEMON_PREFIX}.reading-ssd-backup.plist"
  cat << EOF > "$ssd_backup_plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${P_PREFIX}.reading-ssd-backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>${P_BASH}</string>
        <string>${P_ROOT}/scripts/backup-ssd.sh</string>
        <string>--scheduled</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LIGHTHOUSE_ROOT</key>
        <string>${P_ROOT}</string>
        <key>HOME</key>
        <string>${P_HOME}</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>${ssd_hour}</integer>
        <key>Minute</key>
        <integer>${ssd_minute}</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>${P_LOG_DIR}/reading-ssd-backup.log</string>
    <key>StandardErrorPath</key>
    <string>${P_LOG_DIR}/reading-ssd-backup.log</string>
</dict>
</plist>
EOF

  # Validate all generated plists with plutil if available
  local all_plists=("$uploader_plist" "$bot_plist" "$watchdog_plist" "$vless_plist" "$sg_plist" "$backup_plist" "$ssd_backup_plist")
  for p in "${all_plists[@]}"; do
    if command -v plutil >/dev/null 2>&1; then
      plutil -lint "$p" >/dev/null
    fi
    echo -e "  ${COLOR_GREEN}✓${COLOR_RESET} Generated: $(basename "$p")"
  done

  if [ "$dry_run" -eq 1 ]; then
    echo -e "${COLOR_YELLOW}Dry run: Plists generated but not registered with launchctl.${COLOR_RESET}"
    return 0
  fi

  if [ -z "$output_dir" ] && command -v launchctl >/dev/null 2>&1; then
    echo "Registering LaunchAgents with launchctl..."
    for p in "${all_plists[@]}"; do
      launchctl unload "$p" 2>/dev/null || true
      if [ "$p" = "$ssd_backup_plist" ] && [ "$ssd_enabled" -eq 0 ]; then
        echo -e "  Notice: SSD Auto-Backup is disabled in configuration. Plist generated but left unloaded."
        continue
      fi
      launchctl load -w "$p" 2>/dev/null || true
    done
    echo -e "${COLOR_GREEN}LaunchAgents registered and active.${COLOR_RESET}"
  fi
}

# ------------------------------------------------------------------------------
# 8. Command: backup (Hot SQLite backup with WAL checkpoint, fail-closed)
# ------------------------------------------------------------------------------
cmd_backup() {
  local out_file=""
  local out_dir="${BACKUP_DIR}"

  while [ $# -gt 0 ]; do
    case "$1" in
      --output|-o)
        if [ $# -lt 2 ] || [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
          echo "Error: --output requires a non-empty file path argument" >&2
          exit 1
        fi
        out_file="$2"
        shift 2
        ;;
      --output-dir)
        if [ $# -lt 2 ] || [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
          echo "Error: --output-dir requires a non-empty directory path argument" >&2
          exit 1
        fi
        out_dir="$2"
        shift 2
        ;;
      --help|-h)
        cat << 'EOF'
Usage: bin/lighthouse backup [options]

Create hot SQLite backup with WAL checkpoint, checksum, and manifest.

Options:
  --output, -o <path>      Explicit archive file path
  --output-dir <dir>       Directory to store backup bundle (default: ~/.backups/reading-stack)
  --help, -h               Show this help message
EOF
        exit 0
        ;;
      *)
        echo "Unknown option for backup: $1" >&2
        exit 1
        ;;
    esac
  done

  local timestamp
  timestamp=$(date "+%Y-%m-%d_%H%M%S")
  local iso_time
  iso_time=$(date -u "+%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || date "+%Y-%m-%dT%H:%M:%SZ")

  mkdir -p "$out_dir"

  local temp_dir
  temp_dir=$(mktemp -d /tmp/lighthouse-backup-XXXXXX)
  # shellcheck disable=SC2064
  trap "rm -rf '$temp_dir'" EXIT

  echo -e "${COLOR_BOLD}Starting LightHouse Hot SQLite Backup...${COLOR_RESET}"

  local backed_up_count=0
  local calibre_count=0
  local kosync_count=0
  local cache_count=0
  local manga_count=0

  # 1. Calibre Library metadata.db
  if [ -f "$CALIBRE_DB_PATH" ]; then
    echo -n "  Backing up Calibre metadata (WAL checkpoint + .backup)... "
    sqlite3 "$CALIBRE_DB_PATH" "PRAGMA wal_checkpoint(TRUNCATE);" >/dev/null 2>&1 || true
    if sqlite3 "$CALIBRE_DB_PATH" ".backup '${temp_dir}/metadata.db'"; then
      sqlite3 "${temp_dir}/metadata.db" "PRAGMA quick_check;" >/dev/null 2>&1 || {
        echo -e "${COLOR_RED}CORRUPTED${COLOR_RESET}" >&2
        exit 1
      }
      calibre_count=$(sqlite3 "${temp_dir}/metadata.db" "SELECT count(*) FROM books;" 2>/dev/null || echo 0)
      echo -e "${COLOR_GREEN}OK${COLOR_RESET} (${calibre_count} books)"
      backed_up_count=$((backed_up_count + 1))
    else
      echo -e "${COLOR_RED}FAILED${COLOR_RESET}" >&2
      exit 1
    fi
  else
    echo -e "  Notice: Calibre metadata.db not found at ${CALIBRE_DB_PATH}"
  fi

  # 2. KOSync Progress koreader-sync.db
  if [ -f "$KOSYNC_DB_PATH" ]; then
    echo -n "  Backing up KOSync database (WAL checkpoint + .backup)... "
    sqlite3 "$KOSYNC_DB_PATH" "PRAGMA wal_checkpoint(TRUNCATE);" >/dev/null 2>&1 || true
    if sqlite3 "$KOSYNC_DB_PATH" ".backup '${temp_dir}/koreader-sync.db'"; then
      sqlite3 "${temp_dir}/koreader-sync.db" "PRAGMA quick_check;" >/dev/null 2>&1 || {
        echo -e "${COLOR_RED}CORRUPTED${COLOR_RESET}" >&2
        exit 1
      }
      kosync_count=$(sqlite3 "${temp_dir}/koreader-sync.db" "SELECT count(*) FROM progress;" 2>/dev/null || echo 0)
      echo -e "${COLOR_GREEN}OK${COLOR_RESET} (${kosync_count} progress records)"
      backed_up_count=$((backed_up_count + 1))
    else
      echo -e "${COLOR_RED}FAILED${COLOR_RESET}" >&2
      exit 1
    fi
  else
    echo -e "  Notice: KOSync database not found at ${KOSYNC_DB_PATH}"
  fi

  # 3. Uploader Cache & Jobs cache.db
  if [ -f "$CACHE_DB_PATH" ]; then
    echo -n "  Backing up Uploader cache (WAL checkpoint + .backup)... "
    sqlite3 "$CACHE_DB_PATH" "PRAGMA wal_checkpoint(TRUNCATE);" >/dev/null 2>&1 || true
    if sqlite3 "$CACHE_DB_PATH" ".backup '${temp_dir}/cache.db'"; then
      sqlite3 "${temp_dir}/cache.db" "PRAGMA quick_check;" >/dev/null 2>&1 || {
        echo -e "${COLOR_RED}CORRUPTED${COLOR_RESET}" >&2
        exit 1
      }
      local has_jobs
      if ! has_jobs=$(sqlite3 "${temp_dir}/cache.db" "SELECT count(*) FROM sqlite_master WHERE type='table' AND LOWER(name)='jobs';" 2>&1); then
        echo -e "${COLOR_RED}FAILED (failed to inspect jobs table in cache.db: ${has_jobs})${COLOR_RESET}" >&2
        exit 1
      fi
      if [ "$has_jobs" = "1" ]; then
        if ! cache_count=$(sqlite3 "${temp_dir}/cache.db" "SELECT count(*) FROM jobs;" 2>&1); then
          echo -e "${COLOR_RED}FAILED (failed to query jobs count: ${cache_count})${COLOR_RESET}" >&2
          exit 1
        fi
        echo -e "${COLOR_GREEN}OK${COLOR_RESET} (${cache_count} jobs)"
      else
        cache_count=0
        echo -e "${COLOR_GREEN}OK${COLOR_RESET} (jobs table optional/absent)"
      fi
      backed_up_count=$((backed_up_count + 1))
    else
      echo -e "${COLOR_RED}FAILED${COLOR_RESET}" >&2
      exit 1
    fi
  fi

  # 4. Manga Processor DB (if present)
  if [ -f "$MANGA_DB_PATH" ]; then
    echo -n "  Backing up Manga database... "
    sqlite3 "$MANGA_DB_PATH" "PRAGMA wal_checkpoint(TRUNCATE);" >/dev/null 2>&1 || true
    if sqlite3 "$MANGA_DB_PATH" ".backup '${temp_dir}/manga.db'"; then
      sqlite3 "${temp_dir}/manga.db" "PRAGMA quick_check;" >/dev/null 2>&1 || {
        echo -e "${COLOR_RED}CORRUPTED${COLOR_RESET}" >&2
        exit 1
      }
      manga_count=$(sqlite3 "${temp_dir}/manga.db" "SELECT count(*) FROM sqlite_master;" 2>/dev/null || echo 0)
      echo -e "${COLOR_GREEN}OK${COLOR_RESET}"
      backed_up_count=$((backed_up_count + 1))
    else
      echo -e "${COLOR_RED}FAILED${COLOR_RESET}" >&2
      exit 1
    fi
  fi

  # 5. Credentials & Configuration
  if [ -f "$ENV_FILE" ]; then
    cp "$ENV_FILE" "${temp_dir}/.env"
    chmod 600 "${temp_dir}/.env"
    echo -e "  Included environment credentials: ${COLOR_CYAN}$(basename "$ENV_FILE")${COLOR_RESET}"
  fi

  # Checkpoint all staged DBs and remove ephemeral WAL/SHM artifacts before packing
  for db_f in "${temp_dir}"/*.db; do
    [ -f "$db_f" ] || continue
    sqlite3 "$db_f" "PRAGMA wal_checkpoint(TRUNCATE);" >/dev/null 2>&1 || true
  done
  rm -f "${temp_dir}"/*-wal "${temp_dir}"/*-shm

  if [ "$backed_up_count" -eq 0 ] && [ ! -f "${temp_dir}/.env" ]; then
    echo -e "${COLOR_RED}Error: No databases or configuration found to back up.${COLOR_RESET}" >&2
    exit 1
  fi

  # 6. Generate Manifest
  local hostname_str
  hostname_str=$(hostname 2>/dev/null || echo "unknown")
  cat << EOF > "${temp_dir}/manifest.json"
{
  "version": "${VERSION}",
  "timestamp": "${iso_time}",
  "hostname": "${hostname_str}",
  "databases": {
    "calibre": { "books": ${calibre_count} },
    "kosync": { "progress": ${kosync_count} },
    "cache": { "jobs": ${cache_count} },
    "manga": { "tables": ${manga_count} }
  }
}
EOF

  # 7. Compression
  local bundle_ext="tar.gz"
  local use_zstd=0
  if command -v zstd >/dev/null 2>&1 && tar --help 2>&1 | grep -q zstd; then
    bundle_ext="tar.zst"
    use_zstd=1
  fi

  local target_bundle="${out_file}"
  if [ -z "$target_bundle" ]; then
    target_bundle="${out_dir}/lighthouse-backup-${timestamp}.${bundle_ext}"
  fi

  export COPYFILE_DISABLE=1
  if [ "$use_zstd" -eq 1 ]; then
    tar --zstd -cf "$target_bundle" -C "$temp_dir" .
  else
    tar -czf "$target_bundle" -C "$temp_dir" .
  fi
  chmod 600 "$target_bundle"

  # 8. Checksum Calculation (Bound strictly to $(basename "$target_bundle"))
  local sha_file="${target_bundle}.sha256"
  local bundle_base
  bundle_base=$(basename "$target_bundle")
  local bundle_dir
  bundle_dir=$(dirname "$target_bundle")

  local sha_calculated=0
  if command -v shasum >/dev/null 2>&1; then
    (cd "$bundle_dir" && shasum -a 256 "$bundle_base" > "$(basename "$sha_file")")
    sha_calculated=1
  elif command -v sha256sum >/dev/null 2>&1; then
    (cd "$bundle_dir" && sha256sum "$bundle_base" > "$(basename "$sha_file")")
    sha_calculated=1
  fi
  if [ "$sha_calculated" -eq 0 ]; then
    echo -e "${COLOR_RED}Error: Neither shasum nor sha256sum found on PATH. Checksum generation failed.${COLOR_RESET}" >&2
    exit 1
  fi

  local bundle_size
  bundle_size=$(stat -f%z "$target_bundle" 2>/dev/null || stat -c%s "$target_bundle" 2>/dev/null || echo 0)
  local bundle_size_kb=$(( (bundle_size + 1023) / 1024 ))

  echo ""
  echo -e "${COLOR_GREEN}${COLOR_BOLD}✓ Backup successfully completed!${COLOR_RESET}"
  echo -e "  Bundle:   ${COLOR_BOLD}${target_bundle}${COLOR_RESET} (${bundle_size_kb} KB)"
  echo -e "  Checksum: ${sha_file}"
}

# ------------------------------------------------------------------------------
# 9. Command: restore (WAL replay prevention, strict check, symlink/path guards)
# ------------------------------------------------------------------------------
restore_single_db() {
  local src="${1:-}"
  local dest="${2:-}"
  local count_sql="${3:-}"
  local ts="${4:-}"
  local db_title="${5:-database}"

  if [ -z "$src" ] || [ -z "$dest" ]; then
    echo "Error: restore_single_db requires source and destination arguments" >&2
    exit 1
  fi

  if [ ! -f "$src" ]; then
    echo -e "${COLOR_RED}Error: Source database not found for ${db_title}: ${src}${COLOR_RESET}" >&2
    exit 1
  fi

  # Reject identical source and destination paths to prevent unlinking source
  if [ -e "$dest" ] && [ "$src" -ef "$dest" ]; then
    echo -e "${COLOR_RED}Error: Source and destination cannot be the same file: ${src}${COLOR_RESET}" >&2
    exit 1
  fi

  # Run SQLite integrity check on source before touching destination
  local src_integrity
  src_integrity=$(sqlite3 "$src" "PRAGMA integrity_check;" 2>&1 || echo "failed")
  if [ "$src_integrity" != "ok" ]; then
    echo -e "${COLOR_RED}Error: Integrity check failed on source ${db_title}: ${src_integrity}${COLOR_RESET}" >&2
    exit 1
  fi

  # Pre-screen source database for non-canonical table identifiers before touching destination
  local src_noncanon
  if ! src_noncanon=$(sqlite3 "$src" "SELECT count(*) FROM sqlite_master WHERE type='table' AND name GLOB '*[^a-zA-Z0-9_]*';" 2>&1) || [ "$src_noncanon" != "0" ]; then
    echo -e "${COLOR_RED}Security Error: Database ${db_title} contains non-canonical table identifiers. Restore aborted.${COLOR_RESET}" >&2
    exit 1
  fi

  mkdir -p "$(dirname "$dest")"

  # a) Checkpoint destination if present (withstand busy checkpoint)
  if [ -f "$dest" ]; then
    sqlite3 "$dest" "PRAGMA wal_checkpoint(TRUNCATE);" >/dev/null 2>&1 || true
    cp "$dest" "${dest}.bak.${ts}"
  fi
  # b) Save rollback copies of any existing sidecars
  [ -f "${dest}-wal" ] && cp "${dest}-wal" "${dest}-wal.bak.${ts}"
  [ -f "${dest}-shm" ] && cp "${dest}-shm" "${dest}-shm.bak.${ts}"

  # c) Unconditionally remove existing destination DB, -wal, and -shm to prevent replay of stale WAL
  rm -f "$dest" "${dest}-wal" "${dest}-shm"

  # d) Restore using .restore primitive
  if ! sqlite3 "$dest" ".restore '${src}'" 2>/dev/null; then
    echo -e "${COLOR_RED}Error: Failed to restore ${db_title}: .restore command failed${COLOR_RESET}" >&2
    exit 1
  fi

  # e) Verify PRAGMA integrity_check returns 'ok'
  local check_res
  check_res=$(sqlite3 "$dest" "PRAGMA integrity_check;" 2>&1 || echo "failed")
  if [ "$check_res" != "ok" ]; then
    echo -e "${COLOR_RED}Error: Integrity check failed on restored ${db_title}: ${check_res}${COLOR_RESET}" >&2
    exit 1
  fi

  # Secondary assertion on restored destination
  local dest_noncanon
  if ! dest_noncanon=$(sqlite3 "$dest" "SELECT count(*) FROM sqlite_master WHERE type='table' AND name GLOB '*[^a-zA-Z0-9_]*';" 2>&1) || [ "$dest_noncanon" != "0" ]; then
    echo -e "${COLOR_RED}Security Error: Restored database ${db_title} contains non-canonical table identifiers. Restore aborted.${COLOR_RESET}" >&2
    exit 1
  fi

  # f) Inspect user tables in source and restored database
  local src_tables dest_tables
  if ! src_tables=$(sqlite3 "$src" "SELECT name FROM sqlite_master WHERE type='table' AND NOT (LOWER(name) GLOB 'sqlite_*') ORDER BY name;" 2>&1); then
    echo -e "${COLOR_RED}Error: Failed to inspect tables in source ${db_title}: ${src_tables}${COLOR_RESET}" >&2
    exit 1
  fi
  if ! dest_tables=$(sqlite3 "$dest" "SELECT name FROM sqlite_master WHERE type='table' AND NOT (LOWER(name) GLOB 'sqlite_*') ORDER BY name;" 2>&1); then
    echo -e "${COLOR_RED}Error: Failed to inspect tables in restored ${db_title}: ${dest_tables}${COLOR_RESET}" >&2
    exit 1
  fi

  if [ "$src_tables" != "$dest_tables" ]; then
    echo -e "${COLOR_RED}Error: Schema mismatch on restored ${db_title} (table list differs from source)${COLOR_RESET}" >&2
    exit 1
  fi

  # Check optional jobs table for Cache DB
  local has_jobs=0
  local is_cache_db=0
  if [ "$db_title" = "Cache DB" ] || [ "$(basename "$src")" = "cache.db" ]; then
    is_cache_db=1
    local jobs_check
    if ! jobs_check=$(sqlite3 "$src" "SELECT count(*) FROM sqlite_master WHERE type='table' AND LOWER(name)='jobs';" 2>&1); then
      echo -e "${COLOR_RED}Error: Failed to inspect sqlite_master in source ${db_title}: ${jobs_check}${COLOR_RESET}" >&2
      exit 1
    fi
    if [ "$jobs_check" = "1" ]; then
      has_jobs=1
    fi
  fi

  local skip_count_sql=0
  if [ "$is_cache_db" -eq 1 ] && [ "$has_jobs" -eq 0 ]; then
    if [[ "$count_sql" =~ [[:space:]]jobs[[:space:]\;\.]* ]]; then
      skip_count_sql=1
    fi
  fi

  local primary_count=0
  if [ -n "$count_sql" ] && [ "$skip_count_sql" -eq 0 ]; then
    local src_count dest_count
    if ! src_count=$(sqlite3 "$src" "$count_sql" 2>&1); then
      echo -e "${COLOR_RED}Error: Query failed on source ${db_title}: ${src_count}${COLOR_RESET}" >&2
      exit 1
    fi
    if ! dest_count=$(sqlite3 "$dest" "$count_sql" 2>&1); then
      echo -e "${COLOR_RED}Error: Query failed on restored ${db_title}: ${dest_count}${COLOR_RESET}" >&2
      exit 1
    fi
    if [ "$src_count" != "$dest_count" ]; then
      echo -e "${COLOR_RED}Error: Record count mismatch on restored ${db_title} (src=${src_count}, dest=${dest_count})${COLOR_RESET}" >&2
      exit 1
    fi
    primary_count="$dest_count"
  fi

  local dump_stage_dir
  dump_stage_dir="$(dirname "$src")"
  if [ ! -d "$dump_stage_dir" ] || [ ! -w "$dump_stage_dir" ]; then
    echo -e "${COLOR_RED}Error: Staging directory '${dump_stage_dir}' is not writable for dump verification.${COLOR_RESET}" >&2
    exit 1
  fi

  local src_dump_tmp dest_dump_tmp
  src_dump_tmp=$(mktemp "${dump_stage_dir}/lh-src-dump-XXXXXX")
  dest_dump_tmp=$(mktemp "${dump_stage_dir}/lh-dest-dump-XXXXXX")

  local total_records=0
  if [ -n "$src_tables" ]; then
    while IFS= read -r tbl; do
      [ -z "$tbl" ] && continue

      # Strict validation: table names must be valid SQLite identifiers (alphanumeric and underscore)
      if [[ ! "$tbl" =~ ^[a-zA-Z0-9_]+$ ]]; then
        echo -e "${COLOR_RED}Security Error: Illegal table identifier '${tbl}' in ${db_title}. Restore aborted.${COLOR_RESET}" >&2
        rm -f "$src_dump_tmp" "$dest_dump_tmp"
        exit 1
      fi

      local tbl_escaped="${tbl//\"/\"\"}"

      local tbl_src_count tbl_dest_count
      if ! tbl_src_count=$(sqlite3 "$src" "SELECT count(*) FROM \"${tbl_escaped}\";" 2>&1); then
        echo -e "${COLOR_RED}Error: Failed to query record count for table '${tbl}' in source ${db_title}: ${tbl_src_count}${COLOR_RESET}" >&2
        rm -f "$src_dump_tmp" "$dest_dump_tmp"
        exit 1
      fi
      if ! tbl_dest_count=$(sqlite3 "$dest" "SELECT count(*) FROM \"${tbl_escaped}\";" 2>&1); then
        echo -e "${COLOR_RED}Error: Failed to query record count for table '${tbl}' in restored ${db_title}: ${tbl_dest_count}${COLOR_RESET}" >&2
        rm -f "$src_dump_tmp" "$dest_dump_tmp"
        exit 1
      fi
      if [ "$tbl_src_count" != "$tbl_dest_count" ]; then
        echo -e "${COLOR_RED}Error: Record count mismatch on restored ${db_title} table '${tbl}' (src=${tbl_src_count}, dest=${tbl_dest_count})${COLOR_RESET}" >&2
        rm -f "$src_dump_tmp" "$dest_dump_tmp"
        exit 1
      fi

      total_records=$((total_records + tbl_dest_count))

      # Meaningful content verification via temporary dump files with explicit status checks
      if ! sqlite3 "$src" ".dump \"${tbl_escaped}\"" > "$src_dump_tmp" 2>/dev/null; then
        echo -e "${COLOR_RED}Error: Failed to dump table '${tbl}' from source ${db_title}${COLOR_RESET}" >&2
        rm -f "$src_dump_tmp" "$dest_dump_tmp"
        exit 1
      fi
      if ! sqlite3 "$dest" ".dump \"${tbl_escaped}\"" > "$dest_dump_tmp" 2>/dev/null; then
        echo -e "${COLOR_RED}Error: Failed to dump table '${tbl}' from restored ${db_title}${COLOR_RESET}" >&2
        rm -f "$src_dump_tmp" "$dest_dump_tmp"
        exit 1
      fi
      if ! cmp -s "$src_dump_tmp" "$dest_dump_tmp"; then
        echo -e "${COLOR_RED}Error: Content mismatch on restored ${db_title} table '${tbl}'${COLOR_RESET}" >&2
        rm -f "$src_dump_tmp" "$dest_dump_tmp"
        exit 1
      fi
    done <<< "$src_tables"
  fi

  # Comprehensive whole-database dump comparison (verifies all schema objects, indexes, triggers, views, and sequence state)
  if ! sqlite3 "$src" ".dump" > "$src_dump_tmp" 2>/dev/null; then
    echo -e "${COLOR_RED}Error: Failed to generate full dump from source ${db_title}${COLOR_RESET}" >&2
    rm -f "$src_dump_tmp" "$dest_dump_tmp"
    exit 1
  fi
  if ! sqlite3 "$dest" ".dump" > "$dest_dump_tmp" 2>/dev/null; then
    echo -e "${COLOR_RED}Error: Failed to generate full dump from restored ${db_title}${COLOR_RESET}" >&2
    rm -f "$src_dump_tmp" "$dest_dump_tmp"
    exit 1
  fi
  if ! cmp -s "$src_dump_tmp" "$dest_dump_tmp"; then
    echo -e "${COLOR_RED}Error: Full database content mismatch on restored ${db_title}${COLOR_RESET}" >&2
    rm -f "$src_dump_tmp" "$dest_dump_tmp"
    exit 1
  fi
  rm -f "$src_dump_tmp" "$dest_dump_tmp"

  local display_count="$primary_count"
  if [ "$skip_count_sql" -eq 1 ] || [ -z "$count_sql" ]; then
    display_count="$total_records"
  fi

  echo -e "  ${COLOR_GREEN}✓${COLOR_RESET} Restored ${db_title}: ${dest} (${display_count} records)"
}

cmd_restore() {
  if [ $# -eq 0 ]; then
    echo "Usage: bin/lighthouse restore <bundle-file> [--target <dir>] [--dry-run] [--force]" >&2
    exit 1
  fi

  local bundle=""
  local target_override=""
  local dry_run=0
  local force=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --target)
        if [ $# -lt 2 ] || [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
          echo "Error: --target requires a non-empty directory path argument" >&2
          exit 1
        fi
        target_override="$2"
        shift 2
        ;;
      --dry-run)
        dry_run=1
        shift
        ;;
      --force|-f)
        force=1
        shift
        ;;
      --help|-h)
        cat << 'EOF'
Usage: bin/lighthouse restore <bundle-file> [--target <dir>] [--dry-run] [--force]

Verified restoration of complete stack with integrity checks.

Options:
  --target <dir>           Base directory to restore databases into
  --dry-run                Verify checksum and integrity without modifying files
  --force, -f              Bypass confirmation prompt
  --help, -h               Show this help message
EOF
        exit 0
        ;;
      -*)
        echo "Unknown option for restore: $1" >&2
        exit 1
        ;;
      *)
        if [ -z "$bundle" ]; then
          bundle="$1"
          shift
        else
          echo "Unexpected argument for restore: $1" >&2
          exit 1
        fi
        ;;
    esac
  done

  if [ -z "$bundle" ]; then
    echo "Error: Missing required backup bundle file argument" >&2
    echo "Usage: bin/lighthouse restore <bundle-file> [--target <dir>] [--dry-run] [--force]" >&2
    exit 1
  fi

  if [ ! -f "$bundle" ]; then
    echo -e "${COLOR_RED}Error: Backup bundle not found: ${bundle}${COLOR_RESET}" >&2
    exit 1
  fi

  echo -e "${COLOR_BOLD}Verifying LightHouse Backup Bundle: ${bundle}...${COLOR_RESET}"

  # 1. Require Checksum File and Enforce Strict Match
  local sha_file="${bundle}.sha256"
  if [ ! -f "$sha_file" ]; then
    echo -e "${COLOR_RED}Error: Checksum file not found: ${sha_file}. Restore aborted for security.${COLOR_RESET}" >&2
    exit 1
  fi

  echo -n "  Verifying SHA256 checksum and bound filename... "
  local expected_hash expected_name
  read -r expected_hash expected_name < "$sha_file"
  local clean_expected_name="${expected_name#\*}"

  if [ "$clean_expected_name" != "$(basename "$bundle")" ]; then
    echo -e "${COLOR_RED}FAILED${COLOR_RESET}" >&2
    echo -e "${COLOR_RED}Error: Checksum references '${clean_expected_name}', but bundle is '$(basename "$bundle")'.${COLOR_RESET}" >&2
    exit 1
  fi

  local actual_hash
  if command -v shasum >/dev/null 2>&1; then
    actual_hash=$(shasum -a 256 "$bundle" | awk '{print $1}')
  elif command -v sha256sum >/dev/null 2>&1; then
    actual_hash=$(sha256sum "$bundle" | awk '{print $1}')
  else
    echo -e "${COLOR_RED}Error: shasum or sha256sum required for checksum verification${COLOR_RESET}" >&2
    exit 1
  fi

  if [ "$actual_hash" != "$expected_hash" ]; then
    echo -e "${COLOR_RED}FAILED${COLOR_RESET}" >&2
    echo -e "${COLOR_RED}Error: Checksum mismatch (expected ${expected_hash}, calculated ${actual_hash}).${COLOR_RESET}" >&2
    exit 1
  fi
  echo -e "${COLOR_GREEN}VERIFIED${COLOR_RESET}"

  # 2. Pre-screen Archive Members (Strict Allowlist & Path Confinement)
  echo -n "  Pre-screening archive member paths... "
  local members
  members=$(tar -tf "$bundle" 2>/dev/null || true)
  if [ -z "$members" ]; then
    echo -e "${COLOR_RED}FAILED (empty or unreadable archive)${COLOR_RESET}" >&2
    exit 1
  fi

  # Pre-screen archive member types for symlinks before extraction
  if tar -tvf "$bundle" 2>/dev/null | grep -E '^l|[[:space:]]->[[:space:]]'; then
    echo -e "${COLOR_RED}FAILED${COLOR_RESET}" >&2
    echo -e "${COLOR_RED}Security Error: Archive contains symbolic links. Restore aborted.${COLOR_RESET}" >&2
    exit 1
  fi

  while IFS= read -r member; do
    [ -z "$member" ] && continue

    # Reject path traversal markers or absolute paths on raw member name
    if [[ "$member" =~ ^/ ]] || [[ "$member" =~ \.\. ]]; then
      echo -e "${COLOR_RED}FAILED${COLOR_RESET}" >&2
      echo -e "${COLOR_RED}Security Error: Archive member '${member}' contains illegal traversal markers.${COLOR_RESET}" >&2
      exit 1
    fi

    local clean_member="${member#./}"
    clean_member="${clean_member#/}"
    [ -z "$clean_member" ] && continue

    # Enforce strict allowlist
    case "$clean_member" in
      metadata.db|koreader-sync.db|cache.db|manga.db|manifest.json|.env)
        ;;
      *)
        echo -e "${COLOR_RED}FAILED${COLOR_RESET}" >&2
        echo -e "${COLOR_RED}Security Error: Archive member '${member}' is not in the permitted allowlist.${COLOR_RESET}" >&2
        exit 1
        ;;
    esac
  done <<< "$members"
  echo -e "${COLOR_GREEN}OK${COLOR_RESET}"

  # 3. Extract to Temporary Staging Sandbox
  local staging_dir
  staging_dir=$(mktemp -d /tmp/lighthouse-restore-XXXXXX)
  # shellcheck disable=SC2064
  trap "rm -rf '$staging_dir'" EXIT

  echo -n "  Decompressing into isolated staging sandbox... "
  if [[ "$bundle" =~ \.zst$ ]]; then
    tar --zstd -xf "$bundle" -C "$staging_dir"
  else
    tar -xzf "$bundle" -C "$staging_dir"
  fi
  echo -e "${COLOR_GREEN}OK${COLOR_RESET}"

  # Check for symlink injection in staging directory
  if [ -n "$(find "$staging_dir" -type l 2>/dev/null)" ]; then
    echo -e "${COLOR_RED}Security Error: Symlinks detected in extracted staging sandbox. Restore aborted.${COLOR_RESET}" >&2
    exit 1
  fi

  # 4. SQLite Integrity Checks on all Staged DBs
  echo "  Running SQLite integrity checks on staged databases:"
  for db_file in "${staging_dir}"/*.db; do
    [ -f "$db_file" ] || continue
    local db_name
    db_name=$(basename "$db_file")
    echo -n "    - ${db_name}: "
    local check_res
    check_res=$(sqlite3 "$db_file" "PRAGMA integrity_check;" 2>&1 || echo "failed")
    if [ "$check_res" = "ok" ]; then
      echo -e "${COLOR_GREEN}INTEGRITY OK${COLOR_RESET}"
    else
      echo -e "${COLOR_RED}CORRUPTED (${check_res})${COLOR_RESET}" >&2
      echo -e "${COLOR_RED}Restoration aborted: Database corruption detected in backup.${COLOR_RESET}" >&2
      exit 1
    fi

    # Pre-screen table identifiers in staged database before dry-run, prompt, service stop, or any mutation
    local staged_noncanon
    if ! staged_noncanon=$(sqlite3 "$db_file" "SELECT count(*) FROM sqlite_master WHERE type='table' AND name GLOB '*[^a-zA-Z0-9_]*';" 2>&1) || [ "$staged_noncanon" != "0" ]; then
      echo -e "${COLOR_RED}Security Error: Database ${db_name} contains non-canonical table identifiers. Restore aborted.${COLOR_RESET}" >&2
      exit 1
    fi
  done

  # 5. Dry-run Mode
  if [ "$dry_run" -eq 1 ]; then
    echo ""
    echo -e "${COLOR_YELLOW}${COLOR_BOLD}Dry-run mode: All verification checks passed.${COLOR_RESET}"
    echo "  Staged files verified:"
    (cd "$staging_dir" && ls -la)
    return 0
  fi

  # 6. Confirm Restoration if Not Forced
  if [ "$force" -eq 0 ]; then
    echo ""
    echo -e "${COLOR_YELLOW}Warning: Restoring will overwrite existing databases with data from this bundle.${COLOR_RESET}"
    read -r -p "Do you wish to proceed? [y/N] " response
    case "$response" in
      [yY][eE][sS]|[yY]) ;;
      *) echo "Restoration cancelled."; exit 0 ;;
    esac
  fi

  # 7. Stop Services to Prevent Active SQLite Lock Contention (only for in-place live restore)
  if [ -z "$target_override" ]; then
    echo "Stopping live services before in-place database restoration..."
    cmd_down
  fi

  # 8. Apply Restoration with WAL Checkpoint, Rollback Copies, and .restore Primitive
  local restore_timestamp
  restore_timestamp=$(date "+%Y%m%d_%H%M%S")

  local target_calibre="${CALIBRE_DB_PATH}"
  local target_kosync="${KOSYNC_DB_PATH}"
  local target_cache="${CACHE_DB_PATH}"
  local target_manga="${MANGA_DB_PATH}"

  if [ -n "$target_override" ]; then
    target_calibre="${target_override}/metadata.db"
    target_kosync="${target_override}/koreader-sync.db"
    target_cache="${target_override}/cache.db"
    target_manga="${target_override}/manga.db"
  fi

  [ -f "${staging_dir}/metadata.db" ] && restore_single_db "${staging_dir}/metadata.db" "$target_calibre" "SELECT count(*) FROM books;" "$restore_timestamp" "Calibre DB"
  [ -f "${staging_dir}/koreader-sync.db" ] && restore_single_db "${staging_dir}/koreader-sync.db" "$target_kosync" "SELECT count(*) FROM progress;" "$restore_timestamp" "KOSync DB"

  if [ -f "${staging_dir}/cache.db" ]; then
    local cache_sql="SELECT count(*) FROM jobs;"
    local cache_has_jobs
    if ! cache_has_jobs=$(sqlite3 "${staging_dir}/cache.db" "SELECT count(*) FROM sqlite_master WHERE type='table' AND LOWER(name)='jobs';" 2>&1); then
      echo -e "${COLOR_RED}Error: Failed to inspect sqlite_master in staged cache.db: ${cache_has_jobs}${COLOR_RESET}" >&2
      exit 1
    fi
    if [ "$cache_has_jobs" = "0" ]; then
      cache_sql=""
    fi
    restore_single_db "${staging_dir}/cache.db" "$target_cache" "$cache_sql" "$restore_timestamp" "Cache DB"
  fi
  [ -f "${staging_dir}/manga.db" ] && restore_single_db "${staging_dir}/manga.db" "$target_manga" "SELECT count(*) FROM sqlite_master;" "$restore_timestamp" "Manga DB"

  # Restore .env if present in staging and absent at destination
  local env_dest="${LIGHTHOUSE_ROOT}/.env"
  if [ -n "$target_override" ]; then
    env_dest="${target_override}/.env"
  fi
  if [ -f "${staging_dir}/.env" ] && [ ! -f "$env_dest" ]; then
    cp "${staging_dir}/.env" "$env_dest"
    chmod 600 "$env_dest"
    echo -e "  ${COLOR_GREEN}✓${COLOR_RESET} Restored configuration: ${env_dest}"
  fi

  echo ""
  echo -e "${COLOR_GREEN}${COLOR_BOLD}✓ Restoration complete! All databases restored and verified.${COLOR_RESET}"
  echo "Run 'bin/lighthouse status' or 'bin/lighthouse up' to verify or start the stack."
}

cmd_heal_covers() {
  local script_path="${LIGHTHOUSE_ROOT}/scripts/heal-volume-covers.ts"
  if [ ! -f "$script_path" ]; then
    echo "Error: ${script_path} not found" >&2
    exit 1
  fi
  exec bun run "$script_path" "$@"
}

