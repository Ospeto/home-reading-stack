cmd_firecrawl() {
  local script_path="${LIGHTHOUSE_ROOT}/scripts/firecrawl-cli.ts"
  if [ ! -f "$script_path" ]; then
    echo "Error: ${script_path} not found" >&2
    exit 1
  fi
  export FIRECRAWL_URL FIRECRAWL_PORT FIRECRAWL_COMPOSE_DIR FIRECRAWL_IDLE_TIMEOUT_MS FIRECRAWL_ENABLED
  exec bun run "$script_path" "$@"
}

cmd_backup_ssd() {
  local script_path="${LIGHTHOUSE_ROOT}/scripts/backup-ssd.sh"
  if [ ! -f "$script_path" ]; then
    echo "Error: ${script_path} not found" >&2
    exit 1
  fi

  local target_opt=""
  local time_opt=""
  local schedule_flag=0
  local dry_run_flag=0
  local subcmd=""
  local pass_args=()

  while [ $# -gt 0 ]; do
    case "$1" in
      status)
        subcmd="status"
        shift
        ;;
      set-time)
        subcmd="set-time"
        shift
        if [ $# -gt 0 ]; then
          time_opt="$1"
          shift
        fi
        ;;
      enable|disable)
        subcmd="$1"
        shift
        ;;
      --time)
        if [ $# -lt 2 ]; then
          echo "Error: --time requires a time argument in format HH:MM (e.g. 03:00)" >&2
          exit 1
        fi
        time_opt="$2"
        shift 2
        ;;
      --target)
        if [ $# -lt 2 ]; then
          echo "Error: --target requires a destination path argument" >&2
          exit 1
        fi
        target_opt="$2"
        shift 2
        ;;
      --schedule)
        schedule_flag=1
        shift
        ;;
      --scheduled)
        pass_args+=(--scheduled)
        shift
        ;;
      --dry-run)
        dry_run_flag=1
        shift
        ;;
      *)
        pass_args+=("$1")
        shift
        ;;
    esac
  done

  if [ "$schedule_flag" -eq 1 ]; then
    if [ -n "$time_opt" ]; then
      "$script_path" set-time "$time_opt"
    fi
    exec "$script_path" enable
  fi

  if [ -n "$time_opt" ]; then
    exec "$script_path" set-time "$time_opt"
  fi

  if [ "$subcmd" = "status" ]; then
    exec "$script_path" status
  elif [ "$subcmd" = "set-time" ]; then
    exec "$script_path" set-time "${time_opt:-}"
  elif [ "$subcmd" = "enable" ] || [ "$subcmd" = "disable" ]; then
    exec "$script_path" "$subcmd"
  fi

  local run_args=()
  [ -n "$target_opt" ] && run_args+=(--target "$target_opt")
  [ "$dry_run_flag" -eq 1 ] && run_args+=(--dry-run)
  if [ ${#pass_args[@]} -gt 0 ]; then
    run_args+=("${pass_args[@]}")
  fi

  exec "$script_path" "${run_args[@]}"
}
# ------------------------------------------------------------------------------
# 10. Command: help
# ------------------------------------------------------------------------------
cmd_help() {
  cat << EOF
LightHouse Reading Stack CLI (v${VERSION})
Portable management, health auto-healing, and migration kit.

Usage:
  bin/lighthouse <command> [options]

Commands:
  status                   Display a one-screen dashboard of all ports, tunnels, and services
  up                       Start all services gracefully in dependency order
  down                     Stop all services gracefully in reverse dependency order
  restart                  Restart all services (down followed by up)
  health                   Run automated probes and auto-heal stale listeners/workers
  categorize [options]     Categorize, tag, and correct book languages in Calibre library
  enrich-synopsis [options] Batch enrich missing book synopses from local EPUBs and online APIs
  sync-obsidian [options]  Sync highlights and reading notes from KOReader/Kindle to Obsidian
  sync-kindle [options]    Two-way sync: push books & pull highlights from USB-C Kindle/e-Reader
  heal-covers [options]    Audit & heal Calibre volume covers, purge stale thumbnail caches
  firecrawl <cmd> [options] Control self-hosted Firecrawl on-demand cluster (status|up|down)
  backup-ssd [options]     Incremental whole-library backup to external SSD (rsync + hot SQLite DBs)
  install-daemons          Dynamically generate and register macOS LaunchAgents for current user
  backup [options]         Create hot SQLite backup with WAL checkpoint, checksum, and manifest
  restore <file> [options] Verified restoration of complete stack with integrity checks
  version                  Print CLI version
  help                     Show this help message

Categorize Options:
  --dry-run                Preview language and category updates without modifying library (default)
  --apply                  Apply metadata updates via calibredb set_metadata
  --limit <N>              Limit processing to N books

Enrich-Synopsis Options:
  --dry-run                Preview synopses without modifying library (default)
  --apply                  Apply metadata updates via calibredb set_metadata
  --limit <N>              Limit processing to N books
  --source <type>          Source strategy: all (default), epub, or online
  --re-enrich-duplicates   Re-enrich volumes holding duplicate series summaries
  --verbose                Enable verbose logging of search and extraction steps

Sync-Obsidian Options:
  --vault-path <path>      Obsidian vault path (default: \$OBSIDIAN_VAULT_PATH or ~/Obsidian)
  --dry-run                Preview changes without writing to disk (default)
  --apply                  Write/update markdown notes in <vault>/Books/
  --watch                  Watch library and KOSync DB for changes and auto-sync

Sync-Kindle Options:
  --apply                  Execute transfer and highlight import (default is dry-run)
  --dry-run                Preview synchronization without modifying Kindle or Obsidian
  --status                 Inspect Kindle connection status and exit
  --clean-duplicates       Scan and prune redundant duplicate book files from Kindle
  --jev                    Enable TypeSafe Jev System-1 arbitration for ambiguous duplicates
  --all                    Push all library books instead of only active/unread books
  --force                  Overwrite existing books on Kindle
  --mount <path>           Custom Kindle mount path (default: auto-detect under /Volumes/)
  --vault-path <path>      Custom Obsidian books directory (default: ~/MAS/03-Resources/Books)
  --eject                  Safely unmount/eject Kindle upon successful sync
  --verbose                Enable detailed progress logging
Heal-Covers Options:
  --dry-run                Preview stale/duplicate thumbnail cache detection without deleting (default)
  --apply                  Purge stale thumbnails and restore missing covers from EPUBs
  --series <name>          Filter healing to a specific series title
  --book-id <id>           Filter healing to a specific book ID
  --verbose                Enable verbose logging of cover and cache inspection

Firecrawl Commands:
  status                   Inspect cluster running state, endpoint URL, and auto-sleep timer (default)
  up                       Wake and start containers via docker compose
  down                     Stop containers immediately to release ~2.5 GB RAM back to macOS

Backup-SSD Options:
  status                   Show SSD backup configuration, drive detection, and last backup stats
  set-time <HH:MM>         Update daily scheduled backup time and reload LaunchAgent
  --target <path>          Custom destination path (default: detected or configured SSD)
  --time <HH:MM>           Set schedule time (e.g. --time 03:00)
  --schedule               Enable and register LaunchAgent schedule
  --dry-run                Verify library paths and database connectivity without writing
Backup Options:
  --output, -o <path>      Explicit archive file path
  --output-dir <dir>       Directory to store backup bundle (default: ${BACKUP_DIR})

Restore Options:
  --target <dir>           Base directory to restore databases into
  --dry-run                Verify checksum and integrity without modifying files
  --force, -f              Bypass confirmation prompt

Install-Daemons Options:
  --dry-run                Generate plists without loading into launchctl
  --output-dir <dir>       Write plists to custom directory (default: ~/Library/LaunchAgents)

EOF
}

# ------------------------------------------------------------------------------
# Main Dispatcher
# ------------------------------------------------------------------------------
# Allow test harnesses to source functions without triggering the main command dispatcher
if [ "${LIGHTHOUSE_SOURCE_ONLY:-0}" = "1" ]; then
  # shellcheck disable=SC2317
  return 0 2>/dev/null || exit 0
fi

if [ $# -eq 0 ]; then
  cmd_status
  exit 0
fi

ACTION="$1"
shift

case "$ACTION" in
  status) cmd_status "$@" ;;
  up) cmd_up "$@" ;;
  down) cmd_down "$@" ;;
  restart) cmd_down "$@"; sleep 1; cmd_up "$@" ;;
  health) cmd_health "$@" ;;
  categorize) cmd_categorize "$@" ;;
  enrich-synopsis) cmd_enrich_synopsis "$@" ;;
  heal-covers) cmd_heal_covers "$@" ;;
  sync-obsidian) cmd_sync_obsidian "$@" ;;
  sync-kindle) cmd_sync_kindle "$@" ;;
  firecrawl) cmd_firecrawl "$@" ;;
  backup-ssd) cmd_backup_ssd "$@" ;;
  install-daemons) cmd_install_daemons "$@" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  version|--version|-v) echo "lighthouse version ${VERSION}" ;;
  help|--help|-h) cmd_help ;;
  *)
    echo "Unknown command: ${ACTION}" >&2
    echo "Run 'bin/lighthouse help' for usage." >&2
    exit 1
    ;;
esac
