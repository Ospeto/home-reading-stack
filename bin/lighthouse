EOF

  # 5. Singapore Tunnel Plist
  local sg_plist="${target_dir}/${DAEMON_PREFIX}.reading-sg-tunnel.plist"
  cat << EOF > "$sg_plist"
<?xml version="1.0" encoding="UTF-8"?>
