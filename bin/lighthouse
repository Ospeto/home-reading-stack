#!/bin/bash
# ==============================================================================
# bin/lighthouse
#
# Unified Control CLI for the LightHouse Reading Stack architecture.
# Dynamic path resolution, service lifecycle, auto-healing, and 1-command backup.
# ==============================================================================

set -euo pipefail

# Robust canonical symlink resolution loop
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
LIGHTHOUSE_ROOT="$(cd -P "$DIR/.." && pwd)"
export LIGHTHOUSE_ROOT

# Ensure uploader alias exists for flattened deployment layouts
[ ! -e "${LIGHTHOUSE_ROOT}/uploader" ] && ln -s . "${LIGHTHOUSE_ROOT}/uploader" 2>/dev/null || true

# Ensure standard binaries and Homebrew are available on PATH (preserving caller PATH precedence)
export PATH="${PATH}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

VERSION="1.0.0"

anchor_path() {
  local p="$1"
  case "$p" in
    /*) echo "$p" ;;
    *) echo "${LIGHTHOUSE_ROOT}/${p#./}" ;;
  esac
}

validate_port() {
  local p="$1"
  local name="$2"
  case "$p" in
    ''|*[!0-9]*)
      echo "Error: ${name} must be a numeric integer" >&2
      exit 1
      ;;
  esac
  if [ "$p" -lt 1 ] || [ "$p" -gt 65535 ]; then
    echo "Error: ${name} out of range (1-65535): ${p}" >&2
    exit 1
  fi
}

validate_hostname() {
  local h="$1"
  local name="$2"
  if ! [[ "$h" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: Invalid ${name}: ${h}" >&2
    exit 1
  fi
}

validate_daemon_prefix() {
  local prefix="$1"
  if [[ "$prefix" =~ / ]] || [[ "$prefix" =~ \.\. ]] || ! [[ "$prefix" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: Invalid DAEMON_PREFIX: '${prefix}'. Must match '^[A-Za-z0-9._-]+$' and contain no slashes or '..'" >&2
    exit 1
  fi
}

xml_escape() {
  local s="$1"
  s="${s//&/&amp;}"
  s="${s//</&lt;}"
  s="${s//>/&gt;}"
  s="${s//\"/&quot;}"
  s="${s//\'/&apos;}"
  printf '%s' "$s"
}

# ------------------------------------------------------------------------------
# 1. Environment Loading & Path Defaults (Preserve caller's environment)
# ------------------------------------------------------------------------------
ENV_FILE="${ENV_FILE:-${LIGHTHOUSE_ROOT}/.env}"
if [ ! -f "$ENV_FILE" ] && [ -f "${LIGHTHOUSE_ROOT}/uploader/.env" ]; then
  ENV_FILE="${LIGHTHOUSE_ROOT}/uploader/.env"
fi

CURRENT_USER="$(id -un 2>/dev/null || echo "$USER")"
CURRENT_UID="$(id -u 2>/dev/null || echo 501)"

# Record which variables were already present in caller's environment
PRESET_UPLOADER_PORT="${UPLOADER_PORT+set}"
PRESET_KOSYNC_PORT="${KOSYNC_PORT+set}"
PRESET_CALIBRE_PORT="${CALIBRE_PORT+set}"
PRESET_PROXY_PORT="${PROXY_PORT+set}"
PRESET_PROXY_URL="${PROXY_URL+set}"
PRESET_CALIBRE_SERVER_URL="${CALIBRE_SERVER_URL+set}"
PRESET_US_WAN_HQ_URL="${US_WAN_HQ_URL+set}"
PRESET_SG_OPDS_80_URL="${SG_OPDS_80_URL+set}"
PRESET_SG_KOSYNC_URL="${SG_KOSYNC_URL+set}"
PRESET_US_REMOTE_HOST="${US_REMOTE_HOST+set}"
PRESET_SG_REMOTE_HOST="${SG_REMOTE_HOST+set}"
PRESET_DAEMON_PREFIX="${LIGHTHOUSE_DAEMON_PREFIX+set}"
PRESET_CALIBRE_LIBRARY_DIR="${CALIBRE_LIBRARY_DIR+set}"
PRESET_CALIBRE_DB_PATH="${CALIBRE_DB_PATH+set}"
PRESET_KOSYNC_DB_PATH="${KOSYNC_DB_PATH+set}"
PRESET_CACHE_DB_PATH="${CACHE_DB_PATH+set}"
PRESET_JOBS_DB_PATH="${JOBS_DB_PATH+set}"
PRESET_MANGA_DB_PATH="${MANGA_DB_PATH+set}"
PRESET_BACKUP_DIR="${BACKUP_DIR+set}"
PRESET_LOG_DIR="${LOG_DIR+set}"
PRESET_FIRECRAWL_PORT="${FIRECRAWL_PORT+set}"
PRESET_FIRECRAWL_URL="${FIRECRAWL_URL+set}"
PRESET_FIRECRAWL_COMPOSE_DIR="${FIRECRAWL_COMPOSE_DIR+set}"
PRESET_FIRECRAWL_IDLE_TIMEOUT_MS="${FIRECRAWL_IDLE_TIMEOUT_MS+set}"
PRESET_FIRECRAWL_ENABLED="${FIRECRAWL_ENABLED+set}"
PRESET_ENABLE_US_TUNNEL="${ENABLE_US_TUNNEL+set}"

HAS_EXPLICIT_FIRECRAWL_PORT="${PRESET_FIRECRAWL_PORT:+1}"
HAS_EXPLICIT_FIRECRAWL_URL="${PRESET_FIRECRAWL_URL:+1}"

# Initialize defaults if not already set
UPLOADER_PORT="${UPLOADER_PORT:-8086}"
KOSYNC_PORT="${KOSYNC_PORT:-7200}"
CALIBRE_PORT="${CALIBRE_PORT:-8088}"
PROXY_PORT="${PROXY_PORT:-7890}"
PROXY_URL="${PROXY_URL:-http://127.0.0.1:${PROXY_PORT}}"
CALIBRE_SERVER_URL="${CALIBRE_SERVER_URL:-http://127.0.0.1:${CALIBRE_PORT}}"
US_WAN_HQ_URL="${US_WAN_HQ_URL:-https://reading.wavypremium.xyz}"
SG_OPDS_80_URL="${SG_OPDS_80_URL:-http://opds.wavypremium.xyz/opds}"
SG_KOSYNC_URL="${SG_KOSYNC_URL:-http://kosync-sg.wavypremium.xyz}"
US_REMOTE_HOST="${US_REMOTE_HOST:-panel}"
SG_REMOTE_HOST="${SG_REMOTE_HOST:-sg-vps}"
DAEMON_PREFIX="${LIGHTHOUSE_DAEMON_PREFIX:-com.${CURRENT_USER}}"

CALIBRE_LIBRARY_DIR="${CALIBRE_LIBRARY_DIR:-}"
CALIBRE_DB_PATH="${CALIBRE_DB_PATH:-}"
KOSYNC_DB_PATH="${KOSYNC_DB_PATH:-}"
CACHE_DB_PATH="${CACHE_DB_PATH:-}"
JOBS_DB_PATH="${JOBS_DB_PATH:-}"
MANGA_DB_PATH="${MANGA_DB_PATH:-}"
BACKUP_DIR="${BACKUP_DIR:-}"
LOG_DIR="${LOG_DIR:-${HOME}/Library/Logs}"
FIRECRAWL_PORT="${FIRECRAWL_PORT:-3002}"
FIRECRAWL_URL="${FIRECRAWL_URL:-http://127.0.0.1:${FIRECRAWL_PORT}}"
FIRECRAWL_COMPOSE_DIR="${FIRECRAWL_COMPOSE_DIR:-/Users/ospeto/Documents/Firecrawl/firecrawl}"
FIRECRAWL_IDLE_TIMEOUT_MS="${FIRECRAWL_IDLE_TIMEOUT_MS:-900000}"
FIRECRAWL_ENABLED="${FIRECRAWL_ENABLED:-true}"
ENABLE_US_TUNNEL="${ENABLE_US_TUNNEL:-0}"

if [ -f "$ENV_FILE" ]; then
  while IFS='=' read -r key val || [ -n "$key" ]; do
    key=$(echo "$key" | tr -d '[:space:]')
    [[ "$key" =~ ^#.*$ ]] && continue
    [ -z "$key" ] && continue
    if [[ "$val" =~ ^\"(.*)\"[[:space:]]*(#.*)?$ ]]; then
      val="${BASH_REMATCH[1]}"
    elif [[ "$val" =~ ^\'(.*)\'[[:space:]]*(#.*)?$ ]]; then
      val="${BASH_REMATCH[1]}"
    else
      val="${val%%#*}"
      val=$(echo "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    fi
    val="${val/#\~/$HOME}"
    val="${val//\$\{HOME\}/$HOME}"
    val="${val//\$HOME/$HOME}"
    case "$key" in
      UPLOADER_PORT) [ -z "$PRESET_UPLOADER_PORT" ] && UPLOADER_PORT="$val" ;;
      KOSYNC_PORT) [ -z "$PRESET_KOSYNC_PORT" ] && KOSYNC_PORT="$val" ;;
      CALIBRE_PORT) [ -z "$PRESET_CALIBRE_PORT" ] && CALIBRE_PORT="$val" ;;
      PROXY_PORT) [ -z "$PRESET_PROXY_PORT" ] && PROXY_PORT="$val" ;;
      PROXY_URL) [ -z "$PRESET_PROXY_URL" ] && PROXY_URL="$val" ;;
      CALIBRE_SERVER_URL) [ -z "$PRESET_CALIBRE_SERVER_URL" ] && CALIBRE_SERVER_URL="$val" ;;
      US_WAN_HQ_URL) [ -z "$PRESET_US_WAN_HQ_URL" ] && US_WAN_HQ_URL="$val" ;;
      SG_OPDS_80_URL) [ -z "$PRESET_SG_OPDS_80_URL" ] && SG_OPDS_80_URL="$val" ;;
      SG_KOSYNC_URL) [ -z "$PRESET_SG_KOSYNC_URL" ] && SG_KOSYNC_URL="$val" ;;
      US_REMOTE_HOST) [ -z "$PRESET_US_REMOTE_HOST" ] && US_REMOTE_HOST="$val" ;;
      SG_REMOTE_HOST) [ -z "$PRESET_SG_REMOTE_HOST" ] && SG_REMOTE_HOST="$val" ;;
      LIGHTHOUSE_DAEMON_PREFIX) [ -z "$PRESET_DAEMON_PREFIX" ] && DAEMON_PREFIX="$val" ;;
      CALIBRE_LIBRARY_DIR) [ -z "$PRESET_CALIBRE_LIBRARY_DIR" ] && CALIBRE_LIBRARY_DIR="$(anchor_path "$val")" ;;
      CALIBRE_DB_PATH) [ -z "$PRESET_CALIBRE_DB_PATH" ] && CALIBRE_DB_PATH="$(anchor_path "$val")" ;;
      KOSYNC_DB_PATH) [ -z "$PRESET_KOSYNC_DB_PATH" ] && KOSYNC_DB_PATH="$(anchor_path "$val")" ;;
      CACHE_DB_PATH) [ -z "$PRESET_CACHE_DB_PATH" ] && CACHE_DB_PATH="$(anchor_path "$val")" ;;
      JOBS_DB_PATH) [ -z "$PRESET_JOBS_DB_PATH" ] && JOBS_DB_PATH="$(anchor_path "$val")" ;;
      MANGA_DB_PATH) [ -z "$PRESET_MANGA_DB_PATH" ] && MANGA_DB_PATH="$(anchor_path "$val")" ;;
      BACKUP_DIR) [ -z "$PRESET_BACKUP_DIR" ] && BACKUP_DIR="$(anchor_path "$val")" ;;
      LOG_DIR) [ -z "$PRESET_LOG_DIR" ] && LOG_DIR="$(anchor_path "$val")" ;;
      FIRECRAWL_PORT)
        if [ -z "$PRESET_FIRECRAWL_PORT" ]; then
          FIRECRAWL_PORT="$val"
          HAS_EXPLICIT_FIRECRAWL_PORT="1"
        fi
        ;;
      FIRECRAWL_URL)
        if [ -z "$PRESET_FIRECRAWL_URL" ]; then
          FIRECRAWL_URL="$val"
          HAS_EXPLICIT_FIRECRAWL_URL="1"
        fi
        ;;
      FIRECRAWL_COMPOSE_DIR) [ -z "$PRESET_FIRECRAWL_COMPOSE_DIR" ] && FIRECRAWL_COMPOSE_DIR="$val" ;;
      FIRECRAWL_IDLE_TIMEOUT_MS) [ -z "$PRESET_FIRECRAWL_IDLE_TIMEOUT_MS" ] && FIRECRAWL_IDLE_TIMEOUT_MS="$val" ;;
      FIRECRAWL_ENABLED) [ -z "$PRESET_FIRECRAWL_ENABLED" ] && FIRECRAWL_ENABLED="$val" ;;
      ENABLE_US_TUNNEL) [ -z "$PRESET_ENABLE_US_TUNNEL" ] && ENABLE_US_TUNNEL="$val" ;;
    esac
  done < "$ENV_FILE"
fi

# Keep FIRECRAWL_PORT and FIRECRAWL_URL strictly in sync
if [ -n "$HAS_EXPLICIT_FIRECRAWL_PORT" ] && [ -z "$HAS_EXPLICIT_FIRECRAWL_URL" ]; then
  FIRECRAWL_URL="http://127.0.0.1:${FIRECRAWL_PORT}"
elif [[ "$FIRECRAWL_URL" =~ :([0-9]+) ]]; then
  FIRECRAWL_PORT="${BASH_REMATCH[1]}"
fi

# Fallback compose directory detection
if [ -z "$PRESET_FIRECRAWL_COMPOSE_DIR" ]; then
  if [ -d "${HOME}/Documents/Firecrawl/firecrawl" ]; then
    FIRECRAWL_COMPOSE_DIR="${HOME}/Documents/Firecrawl/firecrawl"
  fi
fi

export FIRECRAWL_URL FIRECRAWL_PORT FIRECRAWL_COMPOSE_DIR FIRECRAWL_IDLE_TIMEOUT_MS FIRECRAWL_ENABLED

# Fallback path resolutions
if [ -z "$CALIBRE_LIBRARY_DIR" ]; then
  if [ -d "${HOME}/Calibre Libraries/Agent Library" ]; then
    CALIBRE_LIBRARY_DIR="${HOME}/Calibre Libraries/Agent Library"
  elif [ -d "${LIGHTHOUSE_ROOT}/data/calibre-library" ]; then
    CALIBRE_LIBRARY_DIR="${LIGHTHOUSE_ROOT}/data/calibre-library"
  else
    CALIBRE_LIBRARY_DIR="${HOME}/Calibre Libraries/Agent Library"
  fi
fi

if [ -z "$CALIBRE_DB_PATH" ]; then
  CALIBRE_DB_PATH="${CALIBRE_LIBRARY_DIR}/metadata.db"
fi

if [ -z "$KOSYNC_DB_PATH" ]; then
  if [ -f "${HOME}/kosync-server/data/koreader-sync.db" ]; then
    KOSYNC_DB_PATH="${HOME}/kosync-server/data/koreader-sync.db"
  elif [ -f "${LIGHTHOUSE_ROOT}/data/kosync/koreader-sync.db" ]; then
    KOSYNC_DB_PATH="${LIGHTHOUSE_ROOT}/data/kosync/koreader-sync.db"
  else
    KOSYNC_DB_PATH="${HOME}/kosync-server/data/koreader-sync.db"
  fi
fi

if [ -z "$CACHE_DB_PATH" ]; then
  if [ -n "$JOBS_DB_PATH" ]; then
    CACHE_DB_PATH="$JOBS_DB_PATH"
  elif [ -f "${LIGHTHOUSE_ROOT}/cache.db" ]; then
    CACHE_DB_PATH="${LIGHTHOUSE_ROOT}/cache.db"
  else
    CACHE_DB_PATH="${LIGHTHOUSE_ROOT}/uploader/cache.db"
  fi
fi

if [ -z "$MANGA_DB_PATH" ]; then
  MANGA_DB_PATH="${HOME}/manga-processor/manga.db"
fi

if [ -z "$BACKUP_DIR" ]; then
  BACKUP_DIR="${HOME}/.backups/reading-stack"
fi

# Ensure paths are absolute
CALIBRE_LIBRARY_DIR="$(anchor_path "$CALIBRE_LIBRARY_DIR")"
CALIBRE_DB_PATH="$(anchor_path "$CALIBRE_DB_PATH")"
KOSYNC_DB_PATH="$(anchor_path "$KOSYNC_DB_PATH")"
CACHE_DB_PATH="$(anchor_path "$CACHE_DB_PATH")"
MANGA_DB_PATH="$(anchor_path "$MANGA_DB_PATH")"
BACKUP_DIR="$(anchor_path "$BACKUP_DIR")"
LOG_DIR="$(anchor_path "$LOG_DIR")"

# ------------------------------------------------------------------------------
# 2. Terminal Styling & Color Helpers
# ------------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  COLOR_RESET="\033[0m"
  COLOR_BOLD="\033[1m"
  COLOR_DIM="\033[2m"
  COLOR_GREEN="\033[32m"
  COLOR_RED="\033[31m"
  COLOR_YELLOW="\033[33m"
  COLOR_CYAN="\033[36m"
else
  COLOR_RESET=""
  COLOR_BOLD=""
  COLOR_DIM=""
  COLOR_GREEN=""
  COLOR_RED=""
  COLOR_YELLOW=""
  COLOR_CYAN=""
fi

badge_active()   { echo -e "${COLOR_GREEN}[ACTIVE]${COLOR_RESET}"; }
badge_inactive() { echo -e "${COLOR_RED}[INACTIVE]${COLOR_RESET}"; }
badge_connected(){ echo -e "${COLOR_GREEN}[CONNECTED]${COLOR_RESET}"; }
badge_running()  { echo -e "${COLOR_GREEN}[RUNNING]${COLOR_RESET}"; }
badge_stopped()  { echo -e "${COLOR_DIM}[STOPPED]${COLOR_RESET}"; }
badge_warn()     { echo -e "${COLOR_YELLOW}[WARN]${COLOR_RESET}"; }

# ------------------------------------------------------------------------------
# 3. System Inspection Primitives
# ------------------------------------------------------------------------------
is_port_listening() {
  local port="$1"
  if command -v nc >/dev/null 2>&1; then
    nc -z -w 1 127.0.0.1 "$port" >/dev/null 2>&1 && return 0
  fi
  if command -v lsof >/dev/null 2>&1; then
    lsof -iTCP:"$port" -sTCP:LISTEN -P -n >/dev/null 2>&1 && return 0
  fi
  return 1
}

get_port_pid() {
  local port="$1"
  if command -v lsof >/dev/null 2>&1; then
    local pid
    pid=$(lsof -iTCP:"$port" -sTCP:LISTEN -Fp 2>/dev/null | head -n 1 | tr -d 'p' || true)
    if [ -n "$pid" ]; then
      echo "$pid"
      return 0
    fi
  fi
  echo "-"
}

get_launchagent_status() {
  local label="$1"
  if command -v launchctl >/dev/null 2>&1; then
    local out
    out=$(launchctl print "gui/${CURRENT_UID}/${label}" 2>&1 || true)
    if echo "$out" | grep -q "state = running"; then
      local pid
      pid=$(echo "$out" | grep "pid =" | grep -oE '[0-9]+' | head -n 1 || echo "")
      if [ -n "$pid" ]; then
        echo "RUNNING:${pid}"
        return 0
      fi
      echo "RUNNING"
      return 0
    fi
  fi
  echo "STOPPED"
}

probe_http_code() {
  local url="$1"
  local timeout="${2:-3}"
  local proxy="${3:-}"
  local cmd=(curl -s -o /dev/null -w "%{http_code}" -m "$timeout")
  if [ -n "$proxy" ]; then
    cmd+=(--proxy "$proxy")
  fi
  cmd+=("$url")
  local res
  res=$("${cmd[@]}" 2>/dev/null || echo "000")
  local code
  code=$(echo "$res" | grep -oE '[0-9]{3}' | head -n 1 || echo "000")
  [ -z "$code" ] && code="000"

  # Fallback to local proxy if direct probe returned 000 and proxy was not already explicitly specified
  if [ "$code" = "000" ] && [ -z "$proxy" ]; then
    local fallback_proxy="${LOCAL_PROXY_URL:-${PROXY_URL:-http://127.0.0.1:7890}}"
    local host_port="${fallback_proxy#*://}"
    host_port="${host_port%%/*}"
    # Strip userinfo if present (user:pass@host:port)
    host_port="${host_port##*@}"
    local proxy_host="${host_port%:*}"
    local proxy_port="${host_port##*:}"
    if [ "$proxy_host" = "$proxy_port" ]; then
      proxy_port=80
    fi
    local proxy_reachable=0
    if [ "$proxy_host" = "127.0.0.1" ] || [ "$proxy_host" = "localhost" ]; then
      if is_port_listening "$proxy_port"; then
        proxy_reachable=1
      fi
    elif command -v nc >/dev/null 2>&1; then
      if nc -z -w 1 "$proxy_host" "$proxy_port" 2>/dev/null; then
        proxy_reachable=1
      fi
    fi

    if [ "$proxy_reachable" -eq 1 ]; then
      local retry_cmd=(curl -s -o /dev/null -w "%{http_code}" -m "$timeout" --proxy "$fallback_proxy" "$url")
      local retry_res
      retry_res=$("${retry_cmd[@]}" 2>/dev/null || echo "000")
      code=$(echo "$retry_res" | grep -oE '[0-9]{3}' | head -n 1 || echo "000")
      [ -z "$code" ] && code="000"
    fi
  fi

  echo "$code"
}

# ------------------------------------------------------------------------------
# 4. Command: status
# ------------------------------------------------------------------------------
cmd_status() {
  local now
  now=$(date "+%Y-%m-%d %H:%M:%S")

  echo -e "${COLOR_BOLD}========================================================================${COLOR_RESET}"
  echo -e "  ${COLOR_CYAN}${COLOR_BOLD}LightHouse Reading Stack — System Status${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}Root: ${LIGHTHOUSE_ROOT} | User: ${CURRENT_USER} | ${now}${COLOR_RESET}"
  echo -e "${COLOR_BOLD}========================================================================${COLOR_RESET}"
  echo ""

  # 1. Local Ports
  echo -e "  ${COLOR_BOLD}LOCAL PORT LISTENERS${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}----------------------------------------------------------------------${COLOR_RESET}"

  # Reading HQ (8086)
  if is_port_listening "$UPLOADER_PORT"; then
    local pid
    pid=$(get_port_pid "$UPLOADER_PORT")
    echo -e "  Port ${UPLOADER_PORT}  $(badge_active)   Reading HQ Dashboard        PID: ${pid}"
  else
    echo -e "  Port ${UPLOADER_PORT}  $(badge_inactive) Reading HQ Dashboard        PID: -"
  fi

  # KOSync (7200)
  if is_port_listening "$KOSYNC_PORT"; then
    local pid
    pid=$(get_port_pid "$KOSYNC_PORT")
    echo -e "  Port ${KOSYNC_PORT}  $(badge_active)   KOSync Server               PID: ${pid}"
  else
    echo -e "  Port ${KOSYNC_PORT}  $(badge_inactive) KOSync Server               PID: -"
  fi

  # Calibre (8088)
  if is_port_listening "$CALIBRE_PORT"; then
    local pid
    pid=$(get_port_pid "$CALIBRE_PORT")
    echo -e "  Port ${CALIBRE_PORT}  $(badge_active)   Calibre Content Server      PID: ${pid}"
  else
    echo -e "  Port ${CALIBRE_PORT}  $(badge_inactive) Calibre Content Server      PID: -"
  fi

  # Sing-box Proxy (7890)
  if is_port_listening "$PROXY_PORT"; then
    local pid
    pid=$(get_port_pid "$PROXY_PORT")
    echo -e "  Port ${PROXY_PORT}  $(badge_active)   Sing-box SOCKS5 Proxy       PID: ${pid}"
  else
    echo -e "  Port ${PROXY_PORT}  $(badge_inactive) Sing-box SOCKS5 Proxy       PID: -"
  fi

  # Firecrawl Scraper (3002, On-Demand)
  if is_port_listening "$FIRECRAWL_PORT"; then
    local pid
    pid=$(get_port_pid "$FIRECRAWL_PORT")
    echo -e "  Port ${FIRECRAWL_PORT}  $(badge_active)   Firecrawl Scraper (On-Demand) PID: ${pid}"
  else
    echo -e "  Port ${FIRECRAWL_PORT}  $(badge_stopped)  Firecrawl Scraper (On-Demand) Sleeping"
  fi
  echo ""

  # 2. WAN Reverse Tunnels
  echo -e "  ${COLOR_BOLD}WAN REVERSE TUNNELS${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}----------------------------------------------------------------------${COLOR_RESET}"

  # US Tunnel Check
  local us_status
  us_status=$(get_launchagent_status "${DAEMON_PREFIX}.reading-vless-tunnel")
  local us_http
  us_http=$(probe_http_code "$US_WAN_HQ_URL" 4)
  if [[ "$us_status" =~ ^RUNNING ]] || [ "$us_http" = "200" ] || [ "$us_http" = "302" ]; then
    echo -e "  US Tunnel (${US_REMOTE_HOST})    $(badge_connected)  ${US_WAN_HQ_URL} (HTTP ${us_http})"
  else
    echo -e "  US Tunnel (${US_REMOTE_HOST})    $(badge_inactive)   ${US_WAN_HQ_URL} (HTTP ${us_http})"
  fi

  # Singapore Tunnel Check
  local sg_status
  sg_status=$(get_launchagent_status "${DAEMON_PREFIX}.reading-sg-tunnel")
  local sg_http
  sg_http=$(probe_http_code "$SG_OPDS_80_URL" 4)
  if [[ "$sg_status" =~ ^RUNNING ]] || [ "$sg_http" = "200" ] || [ "$sg_http" = "302" ]; then
    echo -e "  SG Tunnel (${SG_REMOTE_HOST})    $(badge_connected)  ${SG_OPDS_80_URL} (HTTP ${sg_http})"
  else
    echo -e "  SG Tunnel (${SG_REMOTE_HOST})    $(badge_inactive)   ${SG_OPDS_80_URL} (HTTP ${sg_http})"
  fi
  echo ""

  # 3. Background Daemons (macOS launchd)
  if command -v launchctl >/dev/null 2>&1; then
    echo -e "  ${COLOR_BOLD}BACKGROUND DAEMONS (launchd)${COLOR_RESET}"
    echo -e "  ${COLOR_DIM}----------------------------------------------------------------------${COLOR_RESET}"
    local daemons=(
      "${DAEMON_PREFIX}.book-uploader"
      "${DAEMON_PREFIX}.reading-telegram-bot"
      "${DAEMON_PREFIX}.reading-tunnel-watchdog"
      "${DAEMON_PREFIX}.reading-vless-tunnel"
      "${DAEMON_PREFIX}.reading-sg-tunnel"
      "${DAEMON_PREFIX}.reading-stack-backup"
    )
    for d in "${daemons[@]}"; do
      local st
      st=$(get_launchagent_status "$d")
      if [[ "$st" =~ ^RUNNING:(.+) ]]; then
        local p="${BASH_REMATCH[1]}"
        printf "  %-36s $(badge_running)  PID: %s\n" "$d" "$p"
      elif [ "$st" = "RUNNING" ]; then
        printf "  %-36s $(badge_running)  Active\n" "$d"
      else
        printf "  %-36s $(badge_stopped)  -\n" "$d"
      fi
    done
    echo ""
  fi

  # 4. Storage & Databases
  echo -e "  ${COLOR_BOLD}STORAGE & DATABASES${COLOR_RESET}"
  echo -e "  ${COLOR_DIM}----------------------------------------------------------------------${COLOR_RESET}"

  # Calibre Database
  if [ -f "$CALIBRE_DB_PATH" ]; then
    local count
    count=$(sqlite3 "$CALIBRE_DB_PATH" "SELECT count(*) FROM books;" 2>/dev/null || echo "error")
    echo -e "  Calibre DB:   ${CALIBRE_DB_PATH} (${count} books)"
  else
    echo -e "  Calibre DB:   ${CALIBRE_DB_PATH} ${COLOR_YELLOW}(Not found)${COLOR_RESET}"
  fi

  # KOSync Database
  if [ -f "$KOSYNC_DB_PATH" ]; then
    local count
    count=$(sqlite3 "$KOSYNC_DB_PATH" "SELECT count(*) FROM progress;" 2>/dev/null || echo "error")
    echo -e "  KOSync DB:    ${KOSYNC_DB_PATH} (${count} progress records)"
  else
    echo -e "  KOSync DB:    ${KOSYNC_DB_PATH} ${COLOR_YELLOW}(Not found)${COLOR_RESET}"
  fi

  # Cache Database
  if [ -f "$CACHE_DB_PATH" ]; then
    local count
    count=$(sqlite3 "$CACHE_DB_PATH" "SELECT count(*) FROM jobs;" 2>/dev/null || echo "0")
    echo -e "  Cache DB:     ${CACHE_DB_PATH} (${count} jobs tracked)"
  else
    echo -e "  Cache DB:     ${CACHE_DB_PATH} ${COLOR_YELLOW}(Not found)${COLOR_RESET}"
  fi

  echo -e "${COLOR_BOLD}========================================================================${COLOR_RESET}"
}

# ------------------------------------------------------------------------------
# 5. Command: up & down (Readiness-aware lifecycle)
# ------------------------------------------------------------------------------
cmd_up() {
  validate_daemon_prefix "$DAEMON_PREFIX"
  echo -e "${COLOR_BOLD}Starting LightHouse Reading Stack in dependency order...${COLOR_RESET}"

  if ! command -v launchctl >/dev/null 2>&1; then
    echo "Warning: launchctl not found. Standby mode: please run via docker compose or manual runners."
    exit 0
  fi

  local agents_dir="${HOME}/Library/LaunchAgents"

  # Phase 1: Local services
  local local_services=(
    "${DAEMON_PREFIX}.singbox-proxy"
    "${DAEMON_PREFIX}.kosync"
    "${DAEMON_PREFIX}.calibre-server"
    "${DAEMON_PREFIX}.book-uploader"
    "${DAEMON_PREFIX}.reading-telegram-bot"
    "${DAEMON_PREFIX}.reading-tunnel-watchdog"
  )

  for service in "${local_services[@]}"; do
    local plist="${agents_dir}/${service}.plist"
    if [ -f "$plist" ]; then
      echo -e "  Starting ${COLOR_CYAN}${service}${COLOR_RESET}..."
      launchctl unload "$plist" 2>/dev/null || true
      launchctl load -w "$plist" 2>/dev/null || true
      if launchctl print "gui/${CURRENT_UID}/${service}" >/dev/null 2>&1; then
        launchctl kickstart -k "gui/${CURRENT_UID}/${service}" 2>/dev/null || true
      fi
    fi
  done

  # Bounded readiness check for local HTTP before starting reverse tunnels
  echo -n "  Waiting for local services readiness... "
  local wait_count=0
  while [ "$wait_count" -lt 10 ]; do
    if is_port_listening "$UPLOADER_PORT"; then
      echo -e "${COLOR_GREEN}Ready (:${UPLOADER_PORT} listening)${COLOR_RESET}"
      break
    fi
    sleep 1
    wait_count=$((wait_count + 1))
  done

  # Phase 2: Reverse Tunnels
  local tunnel_services=(
    "${DAEMON_PREFIX}.reading-vless-tunnel"
    "${DAEMON_PREFIX}.reading-sg-tunnel"
  )

  for service in "${tunnel_services[@]}"; do
    local plist="${agents_dir}/${service}.plist"
    if [ -f "$plist" ]; then
      echo -e "  Starting ${COLOR_CYAN}${service}${COLOR_RESET}..."
      launchctl unload "$plist" 2>/dev/null || true
      launchctl load -w "$plist" 2>/dev/null || true
      if launchctl print "gui/${CURRENT_UID}/${service}" >/dev/null 2>&1; then
        launchctl kickstart -k "gui/${CURRENT_UID}/${service}" 2>/dev/null || true
      fi
    fi
  done

  echo -e "${COLOR_GREEN}Stack startup sequence completed.${COLOR_RESET}"
  cmd_status
}

cmd_down() {
  validate_daemon_prefix "$DAEMON_PREFIX"
  echo -e "${COLOR_BOLD}Stopping LightHouse Reading Stack gracefully...${COLOR_RESET}"

  if ! command -v launchctl >/dev/null 2>&1; then
    echo "Warning: launchctl not found."
    return 0
  fi

  local agents_dir="${HOME}/Library/LaunchAgents"

  # Reverse dependency order
  local shutdown_services=(
    "${DAEMON_PREFIX}.reading-sg-tunnel"
    "${DAEMON_PREFIX}.reading-vless-tunnel"
    "${DAEMON_PREFIX}.reading-tunnel-watchdog"
    "${DAEMON_PREFIX}.reading-telegram-bot"
    "${DAEMON_PREFIX}.book-uploader"
    "${DAEMON_PREFIX}.calibre-server"
    "${DAEMON_PREFIX}.kosync"
  )

  for service in "${shutdown_services[@]}"; do
    local plist="${agents_dir}/${service}.plist"
    if [ -f "$plist" ]; then
      echo -e "  Stopping ${COLOR_YELLOW}${service}${COLOR_RESET}..."
      launchctl unload "$plist" 2>/dev/null || true
    fi
  done

  echo -e "${COLOR_GREEN}Stack shutdown sequence completed.${COLOR_RESET}"
}

# ------------------------------------------------------------------------------
# 6. Command: health (Automated probes & auto-healing with validation)
# ------------------------------------------------------------------------------
cmd_health() {
  validate_daemon_prefix "$DAEMON_PREFIX"
  validate_port "$UPLOADER_PORT" "UPLOADER_PORT"
  validate_port "$KOSYNC_PORT" "KOSYNC_PORT"
  validate_hostname "$US_REMOTE_HOST" "US_REMOTE_HOST"
  validate_hostname "$SG_REMOTE_HOST" "SG_REMOTE_HOST"

  echo -e "${COLOR_BOLD}Running LightHouse Health & Auto-Healing Probes...${COLOR_RESET}"
  local failures=0
  local healed=0

  # 1. Local Ports Probe
  echo -n "  Checking Reading HQ (port ${UPLOADER_PORT})... "
  if is_port_listening "$UPLOADER_PORT"; then
    echo -e "$(badge_active)"
  else
    echo -e "$(badge_inactive)"
    failures=$((failures + 1))
    if command -v launchctl >/dev/null 2>&1; then
      echo -e "  ${COLOR_YELLOW}Auto-healing: Kickstarting ${DAEMON_PREFIX}.book-uploader...${COLOR_RESET}"
      launchctl kickstart -k "gui/${CURRENT_UID}/${DAEMON_PREFIX}.book-uploader" 2>/dev/null || true
      sleep 1
      if is_port_listening "$UPLOADER_PORT"; then
        echo -e "  ${COLOR_GREEN}Successfully healed Reading HQ.${COLOR_RESET}"
        healed=$((healed + 1))
        failures=$((failures - 1))
      fi
    fi
  fi

  echo -n "  Checking KOSync Server (port ${KOSYNC_PORT})... "
  if is_port_listening "$KOSYNC_PORT"; then
    echo -e "$(badge_active)"
  else
    echo -e "$(badge_warn) (Offline or containerized)"
  fi

  echo -n "  Checking Calibre Server (port ${CALIBRE_PORT})... "
  if is_port_listening "$CALIBRE_PORT"; then
    echo -e "$(badge_active)"
  else
    echo -e "$(badge_warn) (Offline or containerized)"
  fi

  # 2. WAN Probes & Tunnel Auto-Healing
  echo -n "  Probing US WAN Endpoint (${US_WAN_HQ_URL})... "
  local us_code
  us_code=$(probe_http_code "$US_WAN_HQ_URL" 5)
  if [ "$us_code" = "200" ] || [ "$us_code" = "302" ]; then
    echo -e "${COLOR_GREEN}HTTP ${us_code} OK${COLOR_RESET}"
  elif [ "$ENABLE_US_TUNNEL" != "1" ]; then
    echo -e "${COLOR_YELLOW}HTTP ${us_code} WARN (Decommissioned, ENABLE_US_TUNNEL=${ENABLE_US_TUNNEL})${COLOR_RESET}"
  else
    echo -e "${COLOR_RED}HTTP ${us_code} FAIL${COLOR_RESET}"
    failures=$((failures + 1))
    # Auto-heal: attempt stale remote port clearing and local tunnel restart
    echo -e "  ${COLOR_YELLOW}Auto-healing US Tunnel: clearing remote listeners on ${US_REMOTE_HOST}...${COLOR_RESET}"
    ssh -o ConnectTimeout=5 -o BatchMode=yes "$US_REMOTE_HOST" "fuser -k ${UPLOADER_PORT}/tcp ${KOSYNC_PORT}/tcp 2>/dev/null || true" 2>/dev/null || true
    if command -v launchctl >/dev/null 2>&1; then
      launchctl kickstart -k "gui/${CURRENT_UID}/${DAEMON_PREFIX}.reading-vless-tunnel" 2>/dev/null || true
      sleep 2
      local us_recheck
      us_recheck=$(probe_http_code "$US_WAN_HQ_URL" 5)
      if [ "$us_recheck" = "200" ] || [ "$us_recheck" = "302" ]; then
        echo -e "  ${COLOR_GREEN}Successfully healed US Tunnel.${COLOR_RESET}"
        healed=$((healed + 1))
        failures=$((failures - 1))
      fi
    fi
  fi

  echo -n "  Probing Singapore OPDS Endpoint (${SG_OPDS_80_URL})... "
  local sg_code
  sg_code=$(probe_http_code "$SG_OPDS_80_URL" 5)
  if [ "$sg_code" = "200" ] || [ "$sg_code" = "302" ]; then
    echo -e "${COLOR_GREEN}HTTP ${sg_code} OK${COLOR_RESET}"
  else
    echo -e "${COLOR_RED}HTTP ${sg_code} FAIL${COLOR_RESET}"
    failures=$((failures + 1))
    echo -e "  ${COLOR_YELLOW}Auto-healing SG Tunnel: clearing remote listeners on ${SG_REMOTE_HOST}...${COLOR_RESET}"
    ssh -o ConnectTimeout=5 -o BatchMode=yes "$SG_REMOTE_HOST" "fuser -k ${UPLOADER_PORT}/tcp ${KOSYNC_PORT}/tcp 2>/dev/null || true" 2>/dev/null || true
    if command -v launchctl >/dev/null 2>&1; then
      launchctl kickstart -k "gui/${CURRENT_UID}/${DAEMON_PREFIX}.reading-sg-tunnel" 2>/dev/null || true
      sleep 2
      local sg_recheck
      sg_recheck=$(probe_http_code "$SG_OPDS_80_URL" 5)
      if [ "$sg_recheck" = "200" ] || [ "$sg_recheck" = "302" ]; then
        echo -e "  ${COLOR_GREEN}Successfully healed SG Tunnel.${COLOR_RESET}"
        healed=$((healed + 1))
        failures=$((failures - 1))
      fi
    fi
  fi

  echo ""
  if [ "$failures" -eq 0 ]; then
    echo -e "${COLOR_GREEN}${COLOR_BOLD}Health check passed: All services healthy.${COLOR_RESET}"
    return 0
  else
    echo -e "${COLOR_RED}Health check failed with ${failures} unresolved issue(s) (${healed} healed).${COLOR_RESET}"
    return 1
  fi
}

# ------------------------------------------------------------------------------
# 7. Command: install-daemons (Dynamic launchd generation with XML escaping)
# ------------------------------------------------------------------------------
cmd_install_daemons() {
  local dry_run=0
  local output_dir=""

  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run)
        dry_run=1
        shift
        ;;
      --output-dir)
        if [ $# -lt 2 ] || [ -z "${2:-}" ] || [[ "${2:-}" == -* ]]; then
          echo "Error: --output-dir requires a non-empty directory path argument" >&2
          exit 1
        fi
        output_dir="$2"
        shift 2
        ;;
      --help|-h)
        cat << 'EOF'
Usage: bin/lighthouse install-daemons [options]

Dynamically generate and register macOS LaunchAgents for current user.

Options:
  --dry-run                Generate plists without loading into launchctl
  --output-dir <dir>       Write plists to custom directory (default: ~/Library/LaunchAgents)
  --help, -h               Show this help message
EOF
        exit 0
        ;;
      *)
        echo "Unknown option for install-daemons: $1" >&2
        exit 1
        ;;
    esac
  done

  local target_dir="${output_dir:-${HOME}/Library/LaunchAgents}"
  if [ "$dry_run" -eq 1 ] && [ -z "$output_dir" ]; then
    target_dir=$(mktemp -d /tmp/lighthouse-daemons-dryrun-XXXXXX)
  fi
  local bun_path
  bun_path=$(which bun 2>/dev/null || echo "/opt/homebrew/bin/bun")
  local bash_path
  bash_path=$(which bash 2>/dev/null || echo "/bin/bash")
  local ssh_path
  ssh_path=$(which ssh 2>/dev/null || echo "/usr/bin/ssh")

  validate_port "$UPLOADER_PORT" "UPLOADER_PORT"
  validate_port "$KOSYNC_PORT" "KOSYNC_PORT"
  validate_port "$PROXY_PORT" "PROXY_PORT"
  validate_hostname "$US_REMOTE_HOST" "US_REMOTE_HOST"
  validate_hostname "$SG_REMOTE_HOST" "SG_REMOTE_HOST"
  validate_daemon_prefix "$DAEMON_PREFIX"

  # XML escape all interpolated values
  local P_PREFIX
  P_PREFIX=$(xml_escape "$DAEMON_PREFIX")
  local P_BUN
  P_BUN=$(xml_escape "$bun_path")
  local P_BASH
  P_BASH=$(xml_escape "$bash_path")
  local P_SSH
  P_SSH=$(xml_escape "$ssh_path")
  local P_ROOT
  P_ROOT=$(xml_escape "$LIGHTHOUSE_ROOT")
  local P_HOME
  P_HOME=$(xml_escape "$HOME")
  local P_LOG_DIR
  P_LOG_DIR=$(xml_escape "$LOG_DIR")
  local P_UPLOADER_PORT
  P_UPLOADER_PORT=$(xml_escape "$UPLOADER_PORT")
  local P_KOSYNC_PORT
  P_KOSYNC_PORT=$(xml_escape "$KOSYNC_PORT")
  local P_PROXY_PORT
  P_PROXY_PORT=$(xml_escape "$PROXY_PORT")
  local P_US_REMOTE
  P_US_REMOTE=$(xml_escape "$US_REMOTE_HOST")
  local P_SG_REMOTE
  P_SG_REMOTE=$(xml_escape "$SG_REMOTE_HOST")

  echo -e "${COLOR_BOLD}Generating dynamic launchd plists for User: ${CURRENT_USER}...${COLOR_RESET}"
  echo -e "  Root:       ${LIGHTHOUSE_ROOT}"
  echo -e "  Target Dir: ${target_dir}"
  echo -e "  Bun:        ${bun_path}"

  mkdir -p "$target_dir"
  mkdir -p "$LOG_DIR"

  # 1. Reading HQ Uploader Plist
  local uploader_plist="${target_dir}/${DAEMON_PREFIX}.book-uploader.plist"
  cat << EOF > "$uploader_plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${P_PREFIX}.book-uploader</string>
    <key>ProgramArguments</key>
    <array>
        <string>${P_BUN}</string>
        <string>--env-file=${P_ROOT}/.env</string>
        <string>run</string>
        <string>server.ts</string>
    </array>
    <key>WorkingDirectory</key>
    <string>${P_ROOT}/uploader</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LIGHTHOUSE_ROOT</key>
        <string>${P_ROOT}</string>
        <key>HOME</key>
        <string>${P_HOME}</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${P_LOG_DIR}/uploader.log</string>
    <key>StandardErrorPath</key>
    <string>${P_LOG_DIR}/uploader.log</string>
</dict>
</plist>
EOF

  # 2. Telegram Bot Plist
  local bot_plist="${target_dir}/${DAEMON_PREFIX}.reading-telegram-bot.plist"
  cat << EOF > "$bot_plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${P_PREFIX}.reading-telegram-bot</string>
    <key>ProgramArguments</key>
    <array>
        <string>${P_BUN}</string>
        <string>--env-file=${P_ROOT}/.env</string>
        <string>run</string>
        <string>bot.ts</string>
    </array>
    <key>WorkingDirectory</key>
    <string>${P_ROOT}/uploader</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LIGHTHOUSE_ROOT</key>
        <string>${P_ROOT}</string>
        <key>HOME</key>
        <string>${P_HOME}</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${P_LOG_DIR}/telegram-bot.log</string>
    <key>StandardErrorPath</key>
    <string>${P_LOG_DIR}/telegram-bot.log</string>
</dict>
</plist>
EOF

  # 3. Tunnel Watchdog Plist
  local watchdog_plist="${target_dir}/${DAEMON_PREFIX}.reading-tunnel-watchdog.plist"
  cat << EOF > "$watchdog_plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${P_PREFIX}.reading-tunnel-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>${P_BASH}</string>
        <string>${P_ROOT}/scripts/tunnel-watchdog.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LIGHTHOUSE_ROOT</key>
        <string>${P_ROOT}</string>
        <key>HOME</key>
        <string>${P_HOME}</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>120</integer>
    <key>StandardOutPath</key>
    <string>${P_LOG_DIR}/reading-tunnel-watchdog.log</string>
    <key>StandardErrorPath</key>
    <string>${P_LOG_DIR}/reading-tunnel-watchdog.log</string>
</dict>
</plist>
EOF

  # 4. US VLESS Tunnel Plist
  local vless_plist="${target_dir}/${DAEMON_PREFIX}.reading-vless-tunnel.plist"
  cat << EOF > "$vless_plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${P_PREFIX}.reading-vless-tunnel</string>
    <key>ProgramArguments</key>
    <array>
        <string>${P_SSH}</string>
        <string>-N</string>
        <string>-R</string>
        <string>0.0.0.0:${P_UPLOADER_PORT}:127.0.0.1:${P_UPLOADER_PORT}</string>
        <string>-R</string>
        <string>0.0.0.0:${P_KOSYNC_PORT}:127.0.0.1:${P_KOSYNC_PORT}</string>
        <string>-o</string>
        <string>ProxyCommand=nc -X 5 -x 127.0.0.1:${P_PROXY_PORT} %h %p</string>
        <string>-o</string>
        <string>ServerAliveInterval=15</string>
        <string>-o</string>
        <string>ServerAliveCountMax=3</string>
        <string>-o</string>
        <string>ExitOnForwardFailure=yes</string>
        <string>${P_US_REMOTE}</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>${P_LOG_DIR}/reading-vless-tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>${P_LOG_DIR}/reading-vless-tunnel.log</string>
</dict>
